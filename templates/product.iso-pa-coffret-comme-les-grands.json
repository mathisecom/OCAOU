    "faq": {
      "type": "iso-pa-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Le sac à dos est-il pour les enfants ou pour les parents ?",
            "reponse": "<p>Les deux ! Les bretelles sont réglables, parents et enfants peuvent le porter.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "À partir de quel âge un enfant peut-il le porter ?",
            "reponse": "<p>Dès 2 ans, un enfant peut le porter seul. Il peut préparer son sac TOUT SEUL comme un grand.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "À quoi sert ce sac à dos ?",
            "reponse": "<p>Multifonctions : pour langer, crèche, maternelle, nounou, sport, balades, voyages. Évolutif, il s’adapte à chaque étape de l’enfance.</p>"
          }
        },
        "question_7M3rnp": {
          "type": "question",
          "settings": {
            "question": "Commet on accroche le doudou?",
            "reponse": "<p>Deux solutions : coincez le doudou sous <strong>l’élastique au centre du sac</strong>, ou accrochez-le au <strong>long élastique muni de 2 boucles</strong>, adaptées aux petits comme aux gros doudous. Gardez-les <strong>dans </strong>le sac ou laissez-les<strong> pendre à l’extérieur</strong> : ils restent <strong>faciles à attraper et à ranger</strong>.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Faut-il nécessairement l’ouvrir pour l’utiliser ?",
            "reponse": "<p>Non, il s’utilise aussi comme un sac à dos classique. Toutes les poches sont accessibles en mode sac à dos.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Peut-on ranger d’autres affaires que dans les poches ?",
            "reponse": "<p>Oui, comme dans un sac à dos classique, on met tout dedans.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Comment peut-on accrocher le sac à dos ?",
            "reponse": "<p>Attaches poussettes intégrées, on peut aussi l'accrocher au siège auto et aux barreaux du lit bébé. Il y a 2 poignées aussi.</p>"
          }
        },
        "question_7": {
          "type": "question",
          "settings": {
            "question": "Combien y a-t-il de poches de rangement ?",
            "reponse": "<p>6 poches : une à l'extérieure pour garder l’essentiel à portée de main, et 5 à l'intérieure. </p>"
          }
        },
        "question_8": {
          "type": "question",
          "settings": {
            "question": "Pourquoi y a-t-il des étiquettes dans le sac ?",
            "reponse": "<p>Pour guider le rangement et aider l’enfant à catégoriser ses affaires. Il apprend à lire en rangeant et gagne en autonomie.</p>"
          }
        },
        "question_9": {
          "type": "question",
          "settings": {
            "question": "Peut-on personnaliser le sac à dos ?",
            "reponse": "<p>Oui ! Une étiquette « O’CAOU je le perds » permet d’écrire le prénom de l’enfant.</p>"
          }
        },
        "question_10": {
          "type": "question",
          "settings": {
            "question": "Que faire du surplus de sangle quand l’enfant porte le sac à dos ?",
            "reponse": "<p>Il se glisse dans un passant situé au niveau des bretelles. Rien ne traîne, tout reste bien en place !</p>"
          }
        },
        "question_11": {
          "type": "question",
          "settings": {
            "question": "Quel est le poids du sac à dos ?",
            "reponse": "<p>Entre 360 et 480 grammes selon le modèle. Il est donc parfaitement adapté aux tout-petits !</p>"
          }
        }
      },
