    "custom_liquid_pJwcwk": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "full_width": true,
        "remove_vertical_spacing": false,
        "remove_horizontal_spacing": false,
        "liquid": "{%- comment -%}\n  ============================================================\n  O'CAOU — Cross-sell \"Kit Repas Nomade complet\"\n  A coller dans une section \"Liquid personnalisé\" (Custom Liquid)\n  sur le template produit : composable-coffret-premier-repas\n  Placer cette section À LA PLACE de la section app \"Souvent acheté ensemble\"\n  ============================================================\n  Réglages rapides :\n  - handle du produit complémentaire  -> assign complement_handle\n  - seuil de livraison offerte (en centimes) -> assign seuil_franco\n{%- endcomment -%}\n \n{%- assign complement_handle = 'sac-isotherme' -%}\n{%- assign seuil_franco = 7900 -%}\n \n{%- assign complement = all_products[complement_handle] -%}\n \n{%- if complement != blank and complement.available and product != blank -%}\n  {%- assign total_kit = product.price | plus: complement.price -%}\n  {%- assign var_id = complement.selected_or_first_available_variant.id -%}\n \n  <div class=\"knr\" id=\"knr-{{ section.id }}\">\n    <div class=\"knr-inner\">\n \n      {%- comment -%} ---------- Colonne visuelle ---------- {%- endcomment -%}\n      <div class=\"knr-visuel\">\n        <div class=\"knr-equation\">\n          <figure class=\"knr-vignette\">\n            {%- if product.featured_image -%}\n              <img src=\"{{ product.featured_image | image_url: width: 320 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\" width=\"160\" height=\"160\">\n            {%- endif -%}\n            <figcaption>{{ product.title }}</figcaption>\n          </figure>\n \n          <span class=\"knr-signe\" aria-hidden=\"true\">+</span>\n \n          <figure class=\"knr-vignette\">\n            {%- if complement.featured_image -%}\n              <img src=\"{{ complement.featured_image | image_url: width: 320 }}\" alt=\"{{ complement.title | escape }}\" loading=\"lazy\" width=\"160\" height=\"160\">\n            {%- endif -%}\n            <figcaption>{{ complement.title }}</figcaption>\n          </figure>\n \n          <span class=\"knr-signe knr-signe--egal\" aria-hidden=\"true\">=</span>\n \n          <div class=\"knr-resultat\">\n            <span class=\"knr-resultat-badge\">Kit Repas<br>Nomade<br>complet</span>\n          </div>\n        </div>\n      </div>\n \n      {%- comment -%} ---------- Colonne texte + CTA ---------- {%- endcomment -%}\n      <div class=\"knr-contenu\">\n        <p class=\"knr-eyebrow\">Il ne manque qu'une chose</p>\n        <h2 class=\"knr-titre\">Ajoutez le {{ complement.title }} et vous avez le Kit Repas Nomade complet</h2>\n        <p class=\"knr-accroche\">\n          Le {{ product.title }} nourrit. Le {{ complement.title }} transporte.\n          Ensemble, c'est le repas de votre enfant prêt à partir : crèche, maternelle, balade, vacances.\n        </p>\n \n        <ul class=\"knr-avantages\">\n          <li><span class=\"knr-ico\">🎁</span> Le <strong>pochon O'CAOU offert</strong> <em>(valeur 7,90 €)</em></li>\n          <li><span class=\"knr-ico\">🎁</span> La <strong>poignée nomade offerte</strong> <em>(valeur 5,90 €)</em></li>\n          {%- if total_kit >= seuil_franco -%}\n            <li class=\"knr-franco\"><span class=\"knr-ico\">🚚</span> Le <strong>point relais offert</strong> <em>(dès {{ seuil_franco | money_without_trailing_zeros }} d'achat)</em></li>\n          {%- endif -%}\n          <li><span class=\"knr-ico\">❄️</span> Repas maintenus au frais, sans glacière encombrante</li>\n        </ul>\n \n        <div class=\"knr-prix\">\n          <span class=\"knr-detail\">{{ product.price | money }} <i>+</i> {{ complement.price | money }}</span>\n          <span class=\"knr-total\">{{ total_kit | money }}</span>\n          {%- if total_kit >= seuil_franco -%}\n            <span class=\"knr-pastille\">🚚 Livraison offerte</span>\n          {%- endif -%}\n        </div>\n \n        <button type=\"button\"\n                class=\"knr-btn\"\n                data-knr-add\n                data-variant=\"{{ var_id }}\">\n          Ajouter le {{ complement.title | downcase }} au panier · {{ complement.price | money }}\n        </button>\n \n        <p class=\"knr-note\">\n          Pensez à ajouter votre {{ product.title }} juste au-dessus, avec vos coloris.\n          <a href=\"{{ complement.url }}\">Voir le {{ complement.title | downcase }}</a>\n        </p>\n      </div>\n \n    </div>\n  </div>\n \n  <style>\n    #knr-{{ section.id }} {\n      padding: 28px 20px;\n      background: #FDFBF7;\n      border-top: 1px solid #EFE6D8;\n      border-bottom: 1px solid #EFE6D8;\n    }\n    #knr-{{ section.id }} .knr-inner {\n      max-width: 1100px;\n      margin: 0 auto;\n      display: grid;\n      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);\n      gap: 32px;\n      align-items: center;\n    }\n \n    /* --- visuel / équation --- */\n    #knr-{{ section.id }} .knr-equation {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 10px;\n    }\n    #knr-{{ section.id }} .knr-vignette {\n      margin: 0;\n      text-align: center;\n      width: 92px;\n      flex: 0 0 auto;\n    }\n    #knr-{{ section.id }} .knr-vignette img {\n      width: 92px;\n      height: 92px;\n      object-fit: cover;\n      border-radius: 14px;\n      background: #F0E9DC;\n      border: 2px solid #fff;\n      display: block;\n      box-shadow: 0 2px 10px rgba(0,0,0,.06);\n    }\n    #knr-{{ section.id }} .knr-vignette figcaption {\n      margin-top: 7px;\n      font-size: 11px;\n      line-height: 1.25;\n      font-weight: 600;\n      color: #6b5b4e;\n    }\n    #knr-{{ section.id }} .knr-signe {\n      font-size: 22px;\n      font-weight: 700;\n      color: #C9B79E;\n      margin-bottom: 22px;\n    }\n    #knr-{{ section.id }} .knr-resultat-badge {\n      display: inline-block;\n      padding: 14px 16px;\n      border-radius: 14px;\n      background: #9f6b69;\n      color: #fff;\n      font-size: 12.5px;\n      font-weight: 800;\n      line-height: 1.2;\n      text-transform: uppercase;\n      letter-spacing: .02em;\n      text-align: center;\n      margin-bottom: 22px;\n    }\n \n    /* --- contenu --- */\n    #knr-{{ section.id }} .knr-eyebrow {\n      margin: 0 0 6px;\n      font-size: 11px;\n      font-weight: 800;\n      letter-spacing: .12em;\n      text-transform: uppercase;\n      color: #9f6b69;\n    }\n    #knr-{{ section.id }} .knr-titre {\n      margin: 0 0 10px;\n      font-size: 24px;\n      line-height: 1.2;\n      font-weight: 700;\n      color: #2c2320;\n    }\n    #knr-{{ section.id }} .knr-accroche {\n      margin: 0 0 16px;\n      font-size: 14.5px;\n      line-height: 1.55;\n      color: #4a3f38;\n    }\n    #knr-{{ section.id }} .knr-avantages {\n      list-style: none;\n      margin: 0 0 18px;\n      padding: 0;\n      display: grid;\n      gap: 8px;\n    }\n    #knr-{{ section.id }} .knr-avantages li {\n      display: flex;\n      align-items: flex-start;\n      gap: 9px;\n      font-size: 14px;\n      line-height: 1.4;\n      color: #3a312b;\n    }\n    #knr-{{ section.id }} .knr-avantages em { font-style: normal; color: #8a7c70; }\n    #knr-{{ section.id }} .knr-franco { color: #2f6b4f; font-weight: 600; }\n    #knr-{{ section.id }} .knr-ico { flex: 0 0 auto; }\n \n    #knr-{{ section.id }} .knr-prix {\n      display: flex;\n      align-items: baseline;\n      flex-wrap: wrap;\n      gap: 10px;\n      margin-bottom: 14px;\n    }\n    #knr-{{ section.id }} .knr-detail { font-size: 13px; color: #8a7c70; }\n    #knr-{{ section.id }} .knr-detail i { font-style: normal; margin: 0 2px; }\n    #knr-{{ section.id }} .knr-total { font-size: 22px; font-weight: 800; color: #2c2320; }\n    #knr-{{ section.id }} .knr-pastille {\n      font-size: 11.5px;\n      font-weight: 700;\n      padding: 4px 10px;\n      border-radius: 999px;\n      background: #E7F1EA;\n      color: #2f6b4f;\n    }\n \n    #knr-{{ section.id }} .knr-btn {\n      width: 100%;\n      max-width: 420px;\n      padding: 15px 18px;\n      border: none;\n      border-radius: 999px;\n      background: #E8A94B;\n      color: #fff;\n      font: inherit;\n      font-size: 14.5px;\n      font-weight: 800;\n      cursor: pointer;\n      transition: filter .15s ease;\n    }\n    #knr-{{ section.id }} .knr-btn:hover { filter: brightness(.95); }\n    #knr-{{ section.id }} .knr-btn[disabled] { opacity: .7; cursor: wait; }\n    #knr-{{ section.id }} .knr-btn.is-added { background: #2f6b4f; }\n \n    #knr-{{ section.id }} .knr-note {\n      margin: 10px 0 0;\n      font-size: 12.5px;\n      color: #8a7c70;\n    }\n    #knr-{{ section.id }} .knr-note a { color: #9f6b69; text-decoration: underline; }\n \n    @media (max-width: 860px) {\n      #knr-{{ section.id }} .knr-inner { grid-template-columns: 1fr; gap: 22px; }\n      #knr-{{ section.id }} .knr-titre { font-size: 20px; }\n      #knr-{{ section.id }} .knr-vignette,\n      #knr-{{ section.id }} .knr-vignette img { width: 74px; }\n      #knr-{{ section.id }} .knr-vignette img { height: 74px; }\n      #knr-{{ section.id }} .knr-btn { max-width: none; }\n    }\n  </style>\n \n  <script>\n    (function () {\n      var root = document.getElementById('knr-{{ section.id }}');\n      if (!root) return;\n      var btn = root.querySelector('[data-knr-add]');\n      if (!btn) return;\n \n      btn.addEventListener('click', function () {\n        var id = parseInt(btn.dataset.variant, 10);\n        if (!id) return;\n        var initial = btn.textContent;\n        btn.disabled = true;\n        btn.textContent = 'Ajout en cours…';\n \n        var items = [{ id: id, quantity: 1 }];\n        var done = function () {\n          btn.disabled = false;\n          btn.classList.add('is-added');\n          btn.textContent = '✓ Ajouté au panier';\n        };\n        var fail = function () {\n          btn.disabled = false;\n          btn.textContent = 'Erreur — réessayez';\n          setTimeout(function () { btn.textContent = initial; }, 3000);\n        };\n \n        if (window.OCAOUCart && typeof window.OCAOUCart.add === 'function') {\n          window.OCAOUCart.add(items).then(done).catch(fail);\n        } else {\n          fetch('/cart/add.js', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({ items: items })\n          })\n          .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })\n          .then(function () { done(); window.location.reload(); })\n          .catch(fail);\n        }\n      });\n    })();\n  </script>\n{%- endif -%}",
        "background": "",
        "background_gradient": "",
        "text_color": ""
      }
    }
