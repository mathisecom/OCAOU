{% doc %}
  @prompt
    section pour suggérer des produits souvent achetés ensemble
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bought-together-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-bought-together-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: {{ block.settings.alignment }};
  }

  .ai-bought-together-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-bought-together-{{ ai_gen_id }}__card {
    min-width: 0;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_radius }}px;
    overflow: hidden;
  }

  .ai-bought-together-{{ ai_gen_id }}__image-link,
  .ai-bought-together-{{ ai_gen_id }}__image-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-bought-together-{{ ai_gen_id }}__image-wrap img,
  .ai-bought-together-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bought-together-{{ ai_gen_id }}__image-wrap svg { color: {{ block.settings.muted_color }}; }

  .ai-bought-together-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 16px;
  }

  .ai-bought-together-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 15px;
    line-height: 1.35;
  }

  .ai-bought-together-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-bought-together-{{ ai_gen_id }}__title a:hover { text-decoration: underline; }

  .ai-bought-together-{{ ai_gen_id }}__price {
    color: {{ block.settings.text_color }};
    font-size: 14px;
    font-weight: 600;
  }

  .ai-bought-together-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    width: 100%;
    padding: 8px 14px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_radius }}px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
  }

  .ai-bought-together-{{ ai_gen_id }}__button:hover { opacity: 0.82; }
  .ai-bought-together-{{ ai_gen_id }}__button:focus-visible,
  .ai-bought-together-{{ ai_gen_id }}__title a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  .ai-bought-together-{{ ai_gen_id }}__empty {
    padding: 24px;
    color: {{ block.settings.muted_color }};
    text-align: center;
    border: 1px dashed {{ block.settings.muted_color }};
    border-radius: {{ block.settings.card_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-bought-together-{{ ai_gen_id }} { padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px; }
    .ai-bought-together-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size_mobile }}px; }
    .ai-bought-together-{{ ai_gen_id }}__grid { grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr)); }
    .ai-bought-together-{{ ai_gen_id }}__content { padding: 12px; }
  }
{% endstyle %}

<div class="ai-bought-together-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-bought-together-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if block.settings.products != blank %}
    <div class="ai-bought-together-{{ ai_gen_id }}__grid">
      {% for product in block.settings.products limit: 4 %}
        <article class="ai-bought-together-{{ ai_gen_id }}__card">
          <a class="ai-bought-together-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="Voir {{ product.title | escape }}">
            <div class="ai-bought-together-{{ ai_gen_id }}__image-wrap">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">{% else %}{{ 'product-apparel-1' | placeholder_svg_tag }}{% endif %}
            </div>
          </a>
          <div class="ai-bought-together-{{ ai_gen_id }}__content">
            <h3 class="ai-bought-together-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {% if block.settings.show_prices %}<div class="ai-bought-together-{{ ai_gen_id }}__price">{{ product.price | money }}</div>{% endif %}
            <a class="ai-bought-together-{{ ai_gen_id }}__button" href="{{ product.url }}">{{ block.settings.button_label | escape }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-bought-together-{{ ai_gen_id }}__empty">Sélectionnez des produits à recommander dans l’éditeur de thème.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Produits achetés ensemble",
  "settings": [
    { "type": "header", "content": "Contenu" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Souvent achetés ensemble" },
    { "type": "product_list", "id": "products", "label": "Produits recommandés", "limit": 4 },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir" },
    { "type": "checkbox", "id": "show_prices", "label": "Afficher les prix", "default": true },
    { "type": "header", "content": "Mise en page" },
    { "type": "range", "id": "desktop_width_percent", "label": "Largeur sur ordinateur", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Colonnes sur ordinateur", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Colonnes sur mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "alignment", "label": "Alignement du titre", "options": [{ "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }], "default": "left" },
    { "type": "range", "id": "gap", "label": "Espace entre les cartes", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "heading_size", "label": "Taille du titre", "min": 18, "max": 40, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "heading_size_mobile", "label": "Taille du titre mobile", "min": 16, "max": 32, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "padding_vertical", "label": "Espace vertical", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_horizontal", "label": "Espace horizontal", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_vertical_mobile", "label": "Espace vertical mobile", "min": 0, "max": 60, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_horizontal_mobile", "label": "Espace horizontal mobile", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Fond", "default": "#F4EDE1" },
    { "type": "color", "id": "card_background", "label": "Fond des cartes", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Titre", "default": "#1A1A1A" },
    { "type": "color", "id": "text_color", "label": "Texte", "default": "#1A1A1A" },
    { "type": "color", "id": "muted_color", "label": "Texte secondaire", "default": "#677279" },
    { "type": "color", "id": "placeholder_color", "label": "Fond image vide", "default": "#EDE8E0" },
    { "type": "color", "id": "button_background", "label": "Fond du bouton", "default": "#CD9438" },
    { "type": "color", "id": "button_text_color", "label": "Texte du bouton", "default": "#FFFFFF" },
    { "type": "range", "id": "border_radius", "label": "Arrondi du bloc", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Arrondi des cartes", "min": 0, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "button_radius", "label": "Arrondi du bouton", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Produits achetés ensemble" }],
  "tag": null,
  "class": "bought-together-block"
}
{% endschema %}