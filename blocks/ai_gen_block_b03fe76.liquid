{% doc %}
  @prompt
    Je voudrais créer une section vidéo, avec la possibilité de pouvoir importer mes propres vidéos, je veux que ce soit une section avec 5 vidéos (mais je peux en ajouter ou en retirer si il y en a le besoin) il faut que les vidéos n'aient pas de son et se lance toute seules et tourne en boucle, et ensuite on peut aussi cliquer pour les arrêter ou pour mettre le son. il faut que ce soit des vidéos verticales type instagram/tiktok. il faut que les cards des vidéos ne soient pas trop haute non plus pour que ça ne prenne pas trop d'espace sur la page. il faut que ce soit facile de changer la vidéo d'une card. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-gallery-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px {{ block.settings.side_padding }}px {{ block.settings.padding_bottom }}px;
  }

  .ai-video-gallery-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-video-gallery-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-video-gallery-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-video-gallery-{{ ai_gen_id }}__card {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.card_ratio }};
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-video-gallery-{{ ai_gen_id }}__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }

  .ai-video-gallery-{{ ai_gen_id }}__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 18px;
    color: {{ block.settings.placeholder_text_color }};
    text-align: center;
    font-size: 13px;
  }

  .ai-video-gallery-{{ ai_gen_id }}__empty svg {
    width: 100%;
    height: 100%;
    opacity: .22;
  }

  .ai-video-gallery-{{ ai_gen_id }}__sound {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255,255,255,.75);
    border-radius: 50%;
    background: rgba(0,0,0,.58);
    color: #ffffff;
    cursor: pointer;
  }

  .ai-video-gallery-{{ ai_gen_id }}__sound:focus-visible,
  .ai-video-gallery-{{ ai_gen_id }}__video:focus-visible {
    outline: 2px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-video-gallery-{{ ai_gen_id }}__sound svg {
    width: 17px;
    height: 17px;
  }

  @media screen and (max-width: 749px) {
    .ai-video-gallery-{{ ai_gen_id }} {
      padding-right: {{ block.settings.mobile_side_padding }}px;
      padding-left: {{ block.settings.mobile_side_padding }}px;
    }

    .ai-video-gallery-{{ ai_gen_id }}__inner {
      width: 100%;
    }

    .ai-video-gallery-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-video-gallery-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }
  }
{% endstyle %}

<video-gallery-{{ ai_gen_id }} class="ai-video-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-gallery-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}
      <h2 class="ai-video-gallery-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    <div class="ai-video-gallery-{{ ai_gen_id }}__grid">
      {% for i in (1..8) %}
        {% liquid
          assign enabled_key = 'video_' | append: i | append: '_enabled'
          assign url_key = 'video_' | append: i | append: '_url'
          assign label_key = 'video_' | append: i | append: '_label'
          assign enabled = block.settings[enabled_key]
          assign video_url = block.settings[url_key]
          assign video_label = block.settings[label_key]
        %}
        {% if enabled %}
          <div class="ai-video-gallery-{{ ai_gen_id }}__card">
            {% if video_url != blank %}
              <video class="ai-video-gallery-{{ ai_gen_id }}__video" src="{{ video_url }}" autoplay muted loop playsinline preload="metadata" aria-label="{{ video_label | default: 'Vidéo' | escape }}" tabindex="0"></video>
              <button type="button" class="ai-video-gallery-{{ ai_gen_id }}__sound" aria-label="Activer le son" aria-pressed="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
              </button>
            {% else %}
              <div class="ai-video-gallery-{{ ai_gen_id }}__empty">Ajoutez l’URL d’une vidéo verticale dans les réglages.</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</video-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoGallery{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.querySelectorAll('.ai-video-gallery-{{ ai_gen_id }}__card').forEach((card) => {
          const video = card.querySelector('.ai-video-gallery-{{ ai_gen_id }}__video');
          const sound = card.querySelector('.ai-video-gallery-{{ ai_gen_id }}__sound');
          if (!video || !sound) return;
          video.addEventListener('click', () => {
            if (video.paused) video.play(); else video.pause();
          });
          video.addEventListener('keydown', (event) => {
            if (event.key === 'Enter' || event.key === ' ') {
              event.preventDefault();
              if (video.paused) video.play(); else video.pause();
            }
          });
          sound.addEventListener('click', () => {
            video.muted = !video.muted;
            sound.setAttribute('aria-pressed', String(!video.muted));
            sound.setAttribute('aria-label', video.muted ? 'Activer le son' : 'Couper le son');
          });
        });
      }
    }
    customElements.define('video-gallery-{{ ai_gen_id }}', VideoGallery{{ ai_gen_id }});
  })();
</script>

