{%- comment -%}
  Bandeau « Recommandé par » (ISOMORPH, 18/09/2026)
  Logos fixes et centrés, sans défilement : cinq logos tiennent sur une ligne,
  une animation permanente n'apporte rien et coûte en lisibilité.
  - Liste sémantique, texte alternatif = nom du média (RGAA 4.1, critère 1.1).
  - Images servies aux bonnes dimensions, chargement différé hors premier écran.
  - Remplace « SS - Scrolling logo cloud #5 » et « Presse » : un seul composant.
{%- endcomment -%}

{%- liquid
  assign titre = section.settings.titre
  assign gris = section.settings.grayscale
  assign filtre = 'isopresse-gris-' | append: section.id
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-outer-spacing-block: 0;
    background-color: {{ section.settings.bg_color }};
    padding-block: 28px;
    margin-block: 0;
  }

  {%- if section.settings.filet -%}
  #shopify-section-{{ section.id }} {
    border-top: 1px solid #C9A227;
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .isopresse {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 20px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .isopresse__titre {
    margin: 0 0 16px;
    color: {{ section.settings.titre_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .isopresse__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .isopresse__item {
    flex: 0 0 auto;
    width: 100px;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .isopresse__item img {
    display: block;
    width: 100%;
    height: auto;
    {% if gris %}filter: url(#{{ filtre }});{% endif %}
  }

  #shopify-section-{{ section.id }} .isopresse__filtre {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      padding-block: 40px;
    }

    #shopify-section-{{ section.id }} .isopresse__titre {
      margin-bottom: 24px;
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .isopresse__liste {
      gap: 56px;
    }

    #shopify-section-{{ section.id }} .isopresse__item {
      width: 150px;
    }
  }
{%- endstyle -%}

<section class="isopresse"{% if titre != blank %} aria-labelledby="isopresse-{{ section.id }}"{% endif %}>
  {%- if gris -%}
    <svg class="isopresse__filtre" aria-hidden="true" focusable="false">
      <filter id="{{ filtre }}" color-interpolation-filters="sRGB">
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer>
          <feFuncR type="table" tableValues="0.42 0.44 0.47 0.53 1" />
          <feFuncG type="table" tableValues="0.42 0.44 0.47 0.53 1" />
          <feFuncB type="table" tableValues="0.42 0.44 0.47 0.53 1" />
        </feComponentTransfer>
      </filter>
    </svg>
  {%- endif -%}

  {%- if titre != blank -%}
    <{{ section.settings.titre_tag }} class="isopresse__titre" id="isopresse-{{ section.id }}">{{ titre | escape }}</{{ section.settings.titre_tag }}>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <ul class="isopresse__liste">
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          <li class="isopresse__item" {{ block.shopify_attributes }}>
            {%- capture image -%}
              {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480', sizes: '(min-width: 700px) 150px, 100px', alt: block.settings.nom }}
            {%- endcapture -%}
            {%- if block.settings.url != blank -%}
              <a href="{{ block.settings.url }}">{{ image }}</a>
            {%- else -%}
              {{ image }}
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Recommandé par",
  "tag": "section",
  "class": "iso-presse",
  "settings": [
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Recommandé par"
    },
    {
      "type": "checkbox",
      "id": "filet",
      "label": "Trait doré de séparation au-dessus",
      "default": false
    },
    {
      "type": "select",
      "id": "titre_tag",
      "label": "Niveau de titre",
      "options": [
        {
          "value": "h2",
          "label": "Titre de section (h2)"
        },
        {
          "value": "h3",
          "label": "Sous-titre (h3)"
        },
        {
          "value": "p",
          "label": "Texte simple"
        }
      ],
      "default": "h2"
    },
    {
      "type": "color",
      "id": "titre_color",
      "label": "Couleur du titre",
      "default": "#121212"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Harmoniser les logos en gris",
      "default": false,
      "info": "Ramène tous les logos à la même teinte grise."
    },
    {
      "type": "header",
      "content": "Bandeau"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "nom",
          "label": "Nom du média",
          "info": "Lu par les lecteurs d'écran à la place de l'image."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Lien (facultatif)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Recommandé par",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}

