{% comment %}
================================================================
  SECTION O'CAOU — Les coffrets (page d'accueil)
  À placer dans : sections/ocaou-coffrets.liquid

  VERSION "OFFRIR CE COFFRET" → REDIRIGE VERS LA FICHE PRODUIT
  (aucun ajout au panier, uniquement une redirection)

  ▸ Chaque carte utilise un véritable produit coffret créé dans
    Shopify Bundles, uniquement pour récupérer son prix réel et
    l'URL de sa fiche produit.
  ▸ Le bouton principal (« Offrir ce coffret ») ne fait plus
    d'ajout au panier : il redirige simplement le client vers la
    fiche produit du coffret sélectionné.
  ▸ Les produits 1, 2 et 3 servent uniquement à afficher la
    composition, le prix total barré et l'avantage client.
  ▸ Pour un coffret complémentable, créez un second produit bundle
    contenant le coffret complet, par exemple : Balades + Pochette.
    Le bouton secondaire bascule l'affichage (prix, avantage) et
    la destination du bouton principal entre le bundle de base et
    le bundle complet, sans quitter la page.

  INSTALLATION :
  1. Créez chaque coffret dans l'application Shopify Bundles.
  2. Pour un coffret complémentable, créez également sa version
     complète, par exemple « Coffret Balades + Pochette ».
  3. Modifier le code > sections > Ajouter une nouvelle section.
  4. Nommer la section : ocaou-coffrets (.liquid).
  5. Coller ce fichier puis enregistrer.
  6. Dans l'éditeur du thème, sélectionnez pour chaque carte :
     - le produit coffret Shopify Bundles réellement vendu ;
     - les produits de composition servant à l'affichage ;
     - éventuellement le produit coffret complet.

  IMPORTANT : le prix n'est plus saisi manuellement dans cette
  section. Modifiez le prix directement sur le produit bundle dans
  Shopify pour que l'affichage reste synchronisé avec la fiche
  produit.
================================================================
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

<style>
  #coffrets-{{ uid }} {
    background: {{ s.bg_color }};
    border-radius: {{ s.section_radius }}px;
    margin: 0 {{ s.side_margin }}px {{ s.margin_bottom }}px;
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
  }
  #coffrets-{{ uid }} .cof-inner {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
    padding: 0 22px;
  }

  #coffrets-{{ uid }} .cof-eyebrow {
    display: block;
    text-align: center;
    font-size: {{ s.eyebrow_size }}px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: {{ s.eyebrow_color }};
    margin: 0 0 {{ s.eyebrow_margin_bottom }}px;
  }
  #coffrets-{{ uid }} .cof-title {
    text-align: center;
    font-size: {{ s.title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ s.title_color }};
    margin: 0 0 {{ s.subtitle_margin_top }}px;
  }
  #coffrets-{{ uid }} .cof-subtitle {
    text-align: center;
    max-width: 640px;
    margin: 0 auto {{ s.subtitle_margin_bottom }}px;
    font-size: {{ s.subtitle_size }}px;
    color: {{ s.subtitle_color }};
    line-height: 1.55;
  }

  #coffrets-{{ uid }} .cof-grid {
    display: grid;
    grid-template-columns: repeat({{ s.columns_desktop }}, minmax(0,1fr));
    gap: {{ s.col_gap }}px;
    align-items: stretch;
  }

  #coffrets-{{ uid }} .cof-card {
    background: {{ s.card_bg }};
    border-radius: {{ s.card_radius }}px;
    padding: {{ s.card_padding }}px;
    position: relative;
    display: flex;
    flex-direction: column;
  }
  #coffrets-{{ uid }} .cof-badge {
    display: inline-flex;
    align-self: flex-start;
    background: {{ s.badge_bg }};
    color: {{ s.badge_color }};
    font-weight: 700;
    font-size: {{ s.badge_size }}px;
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  #coffrets-{{ uid }} .cof-visu {
    border-radius: {{ s.visu_radius }}px;
    background:
      radial-gradient(circle, rgba(255,255,255,.9) 0 3px, transparent 4px) 0 0 / 26px 26px,
      {{ s.visu_bg }};
    height: {{ s.visu_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: {{ s.emoji_size }}px;
    margin-bottom: 20px;
    overflow: hidden;
    position: relative;
  }
  #coffrets-{{ uid }} .cof-visu img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #coffrets-{{ uid }} .cof-name {
    font-size: {{ s.card_title_size }}px;
    font-weight: 700;
    color: {{ s.card_title_color }};
    margin: 0 0 8px;
  }
  #coffrets-{{ uid }} .cof-compo {
    font-size: {{ s.compo_size }}px;
    color: {{ s.compo_color }};
    line-height: 1.5;
    margin: 0 0 2px;
  }
  #coffrets-{{ uid }} .cof-compo-generic {
    font-size: {{ s.compo_size }}px;
    color: {{ s.compo_color }};
    opacity: .7;
    font-style: italic;
    line-height: 1.5;
    margin: 0 0 18px;
  }

  #coffrets-{{ uid }} .cof-prices {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
  }
  #coffrets-{{ uid }} .cof-prices s {
    font-size: {{ s.price_old_size }}px;
    color: {{ s.price_old_color }};
  }
  #coffrets-{{ uid }} .cof-prices .now {
    font-size: {{ s.price_new_size }}px;
    font-weight: 800;
    color: {{ s.price_new_color }};
    transition: color .2s ease;
  }
  #coffrets-{{ uid }} .cof-prices .now.is-updated {
    color: {{ s.btn_added_bg }};
  }

  #coffrets-{{ uid }} .cof-advantages {
    margin: 0 0 18px;
  }
  #coffrets-{{ uid }} .cof-advantages p {
    font-size: {{ s.gift_size }}px;
    font-weight: 700;
    color: {{ s.gift_color }};
    margin: 0 0 4px;
    line-height: 1.4;
  }
  #coffrets-{{ uid }} .cof-advantages p.cof-advantage-final {
    color: {{ s.advantage_final_color }};
  }

  #coffrets-{{ uid }} .cof-complement {
    background: {{ s.complement_bg }};
    border: 1px dashed {{ s.complement_border }};
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 18px;
  }
  #coffrets-{{ uid }} .cof-complement-title {
    font-weight: 700;
    font-size: {{ s.gift_size }}px;
    color: {{ s.card_title_color }};
    margin: 0 0 4px;
  }
  #coffrets-{{ uid }} .cof-complement-text {
    font-size: {{ s.compo_size }}px;
    color: {{ s.compo_color }};
    margin: 0 0 8px;
    line-height: 1.4;
  }
  #coffrets-{{ uid }} .cof-complement-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 10px;
  }
  #coffrets-{{ uid }} .cof-complement-price s {
    font-size: {{ s.price_old_size }}px;
    color: {{ s.price_old_color }};
  }
  #coffrets-{{ uid }} .cof-complement-price span {
    font-size: {{ s.compo_size }}px;
    font-weight: 800;
    color: {{ s.price_new_color }};
  }

  #coffrets-{{ uid }} .cof-btn {
    display: block;
    width: 100%;
    border: none;
    cursor: pointer;
    background: {{ s.btn_bg }};
    color: {{ s.btn_color }};
    font-weight: 700;
    font-size: {{ s.btn_size }}px;
    padding: 15px 20px;
    border-radius: {{ s.btn_radius }}px;
    transition: opacity .15s ease, transform .15s ease, background .2s ease;
  }
  #coffrets-{{ uid }} .cof-btn:hover { opacity: .92; transform: translateY(1px); }
  #coffrets-{{ uid }} .cof-btn.is-added { background: {{ s.btn_added_bg }}; }
  #coffrets-{{ uid }} .cof-btn:disabled { opacity: .55; cursor: not-allowed; }

  #coffrets-{{ uid }} .cof-btn-complement {
    background: {{ s.complement_btn_bg }};
    color: {{ s.complement_btn_color }};
    margin-bottom: 0;
  }
  #coffrets-{{ uid }} .cof-btn-complement.is-active {
    background: {{ s.btn_added_bg }};
    color: #fff;
  }

  #coffrets-{{ uid }} .cof-btn-main {
    margin-top: 10px;
  }

  #coffrets-{{ uid }} .cof-more {
    text-align: center;
    margin-top: {{ s.footer_margin_top }}px;
  }
  #coffrets-{{ uid }} .cof-more a {
    color: {{ s.footer_link_color }};
    font-weight: 700;
    text-decoration: none;
    font-size: {{ s.footer_size }}px;
  }
  #coffrets-{{ uid }} .cof-more a:hover { text-decoration: underline; }

  /* ── Responsive mobile ── */
  @media (max-width: 749px) {
    #coffrets-{{ uid }} {
      border-radius: {{ s.section_radius_mobile }}px;
      margin: 0 {{ s.side_margin_mobile }}px {{ s.margin_bottom_mobile }}px;
      padding: {{ s.padding_top_mobile }}px 0 {{ s.padding_bottom_mobile }}px;
    }
    #coffrets-{{ uid }} .cof-eyebrow { font-size: {{ s.eyebrow_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-title { font-size: {{ s.title_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-subtitle { font-size: {{ s.subtitle_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-grid {
      grid-template-columns: repeat({{ s.columns_mobile }}, minmax(0,1fr));
      gap: {{ s.col_gap_mobile }}px;
    }
    #coffrets-{{ uid }} .cof-card { padding: {{ s.card_padding_mobile }}px; }
    #coffrets-{{ uid }} .cof-visu { height: {{ s.visu_height_mobile }}px; font-size: {{ s.emoji_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-name { font-size: {{ s.card_title_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-compo,
    #coffrets-{{ uid }} .cof-compo-generic { font-size: {{ s.compo_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-prices .now { font-size: {{ s.price_new_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-prices s { font-size: {{ s.price_old_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-advantages p { font-size: {{ s.gift_size_mobile }}px; }
    #coffrets-{{ uid }} .cof-btn { font-size: {{ s.btn_size_mobile }}px; padding: 13px 18px; }
  }
</style>

<div id="coffrets-{{ uid }}">
  <div class="cof-inner">

    {% if s.eyebrow != blank %}<span class="cof-eyebrow">{{ s.eyebrow }}</span>{% endif %}
    {% if s.title != blank %}<h2 class="cof-title">{{ s.title }}</h2>{% endif %}
    {% if s.subtitle != blank %}<p class="cof-subtitle">{{ s.subtitle }}</p>{% endif %}

    <div class="cof-grid">
      {% for block in section.blocks %}
        {%- liquid
          assign v1 = block.settings.produit1.selected_or_first_available_variant
          assign v2 = block.settings.produit2.selected_or_first_available_variant
          assign v3 = block.settings.produit3.selected_or_first_available_variant

          assign coffret_variant = block.settings.produit_coffret.selected_or_first_available_variant
          assign coffret_complet_variant = block.settings.produit_coffret_complet.selected_or_first_available_variant
          assign comp_variant = block.settings.complement_produit.selected_or_first_available_variant

          assign total = 0

          if v1 != blank
            assign total = total | plus: v1.price
          endif
          if v2 != blank
            assign total = total | plus: v2.price
          endif
          if v3 != blank
            assign total = total | plus: v3.price
          endif

          assign coffret_cents = 0
          assign coffret_variant_id = ''
          assign coffret_available = false
          assign coffret_url = ''

          if coffret_variant != blank
            assign coffret_cents = coffret_variant.price
            assign coffret_variant_id = coffret_variant.id
            assign coffret_available = coffret_variant.available
            assign coffret_url = block.settings.produit_coffret.url
          endif

          assign pochon_value = block.settings.pochon_valeur
          if pochon_value == blank
            assign pochon_value = 7.9
          endif
          assign pochon_cents = pochon_value | times: 100 | round
          assign avantage_cents = total | minus: coffret_cents | plus: pochon_cents

          assign compo_text = block.settings.composition
          if compo_text == blank
            assign parts = ''
            if block.settings.produit1 != blank
              assign parts = parts | append: block.settings.produit1.title
            endif
            if block.settings.produit2 != blank
              if parts != blank
                assign parts = parts | append: ' + '
              endif
              assign parts = parts | append: block.settings.produit2.title
            endif
            if block.settings.produit3 != blank
              if parts != blank
                assign parts = parts | append: ' + '
              endif
              assign parts = parts | append: block.settings.produit3.title
            endif
            assign compo_text = parts
          endif

          assign has_complement = false
          assign coffret_complet_variant_id = ''
          assign coffret_complet_available = false
          assign coffret_complet_url = ''
          assign total_with_complement_cents = 0
          assign comp_normal_cents = 0
          assign comp_remise_cents = 0
          assign total_products_with_complement = total
          assign avantage_complet_cents = avantage_cents

          if block.settings.complement_actif and coffret_variant != blank and coffret_complet_variant != blank
            assign has_complement = true
            assign coffret_complet_variant_id = coffret_complet_variant.id
            assign coffret_complet_available = coffret_complet_variant.available
            assign coffret_complet_url = block.settings.produit_coffret_complet.url
            assign total_with_complement_cents = coffret_complet_variant.price
            assign comp_remise_cents = total_with_complement_cents | minus: coffret_cents

            if comp_variant != blank
              assign comp_normal_cents = comp_variant.price
              assign total_products_with_complement = total | plus: comp_normal_cents
            else
              assign comp_normal_cents = comp_remise_cents
              assign total_products_with_complement = total | plus: comp_remise_cents
            endif

            assign avantage_complet_cents = total_products_with_complement | minus: total_with_complement_cents | plus: pochon_cents
          endif
        -%}

        <div class="cof-card" {{ block.shopify_attributes }}>
          {% if block.settings.badge != blank %}
            <span class="cof-badge">{{ block.settings.badge }}</span>
          {% endif %}

          <div class="cof-visu">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.titre }}
            {% else %}
              {% if block.settings.emoji1 != blank %}<span>{{ block.settings.emoji1 }}</span>{% endif %}
              {% if block.settings.emoji2 != blank %}<span>{{ block.settings.emoji2 }}</span>{% endif %}
              {% if block.settings.emoji3 != blank %}<span>{{ block.settings.emoji3 }}</span>{% endif %}
            {% endif %}
          </div>

          <h3 class="cof-name">{{ block.settings.titre }}</h3>
          {% if compo_text != blank %}<p class="cof-compo">{{ compo_text }}</p>{% endif %}
          {% if block.settings.composition_generique != blank %}
            <p class="cof-compo-generic">{{ block.settings.composition_generique }}</p>
          {% endif %}

          {% if coffret_variant != blank %}
            <div class="cof-prices">
              <s
                class="cof-price-old"
                data-price-base="{{ total | money }}"
                data-price-complete="{{ total_products_with_complement | money }}"
                data-show-base="{% if total > coffret_cents %}true{% else %}false{% endif %}"
                data-show-complete="{% if total_products_with_complement > total_with_complement_cents %}true{% else %}false{% endif %}"
                {% unless total > coffret_cents %}style="display:none"{% endunless %}>
                {{ total | money }}
              </s>
              <span class="now">{{ coffret_cents | money }}</span>
            </div>

            <div class="cof-advantages">
              <p>🎁 Pochon cadeau « O’CAOU c’est pour offrir » — valeur {{ pochon_cents | money }} OFFERT</p>
              <p>🚚 LIVRAISON OFFERTE</p>
              <p
                class="cof-advantage-final"
                data-advantage-base="Votre avantage : {{ avantage_cents | money }} + la livraison offerte"
                data-advantage-complete="Votre avantage : {{ avantage_complet_cents | money }} + la livraison offerte"
                data-show-base="{% if avantage_cents > 0 %}true{% else %}false{% endif %}"
                data-show-complete="{% if avantage_complet_cents > 0 %}true{% else %}false{% endif %}"
                {% unless avantage_cents > 0 %}style="display:none"{% endunless %}>
                Votre avantage : {{ avantage_cents | money }} + la livraison offerte
              </p>
            </div>
          {% else %}
            <p style="font-size:12px;line-height:1.5;color:#BC4A33;font-weight:700;margin:0 0 18px;">
              ⚠️ Sélectionnez le produit coffret Shopify Bundles dans les réglages de cette carte.
            </p>
          {% endif %}

          {% if has_complement %}
            <div class="cof-complement">
              <p class="cof-complement-title">→ O’CAOU je complète ?</p>
              <p class="cof-complement-text">{{ block.settings.complement_texte }}</p>
              <p class="cof-complement-price">
                <s>{{ comp_normal_cents | money }}</s>
                <span>{{ comp_remise_cents | money }}</span>
              </p>
              <button
                type="button"
                class="cof-btn cof-btn-complement"
                data-available-base="{{ coffret_available }}"
                data-available-complete="{{ coffret_complet_available }}"
                data-url-base="{{ coffret_url }}"
                data-url-complete="{{ coffret_complet_url }}"
                data-price-base="{{ coffret_cents | money }}"
                data-price-total="{{ total_with_complement_cents | money }}"
                data-label-default="{{ block.settings.complement_bouton_texte | default: 'Je complète mon coffret' }}"
                data-label-active="✓ POCHETTE AJOUTÉE"
                {% unless coffret_complet_available %}disabled{% endunless %}>
                {% if coffret_complet_available %}
                  {{ block.settings.complement_bouton_texte | default: 'Je complète mon coffret' }}
                {% else %}
                  Coffret complet indisponible
                {% endif %}
              </button>
            </div>
          {% endif %}

          {% if coffret_variant != blank %}
            <button
              type="button"
              class="cof-btn cof-btn-main"
              data-url="{{ coffret_url }}"
              data-url-base="{{ coffret_url }}"
              data-url-complete="{{ coffret_complet_url }}"
              data-available-base="{{ coffret_available }}"
              data-available-complete="{{ coffret_complet_available }}"
              data-label-default="{{ block.settings.bouton_texte | default: 'Offrir ce coffret' }}"
              {% unless coffret_available %}disabled{% endunless %}>
              {% if coffret_available %}
                {{ block.settings.bouton_texte | default: 'Offrir ce coffret' }}
              {% else %}
                Coffret indisponible
              {% endif %}
            </button>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if s.footer_text != blank %}
      <div class="cof-more">
        <a href="{{ s.footer_link | default: '#' }}">{{ s.footer_text }}</a>
      </div>
    {% endif %}

  </div>
</div>

<script>
(function () {
  var section = document.getElementById('coffrets-{{ uid }}');
  if (!section || section.dataset.cofInit) return;
  section.dataset.cofInit = '1';

  // Bouton « Je complète mon coffret » :
  // met à jour l'affichage (prix, avantage) et la destination
  // du bouton principal, qui basculera vers la fiche produit
  // du coffret complet au lieu du coffret de base.
  section.querySelectorAll('.cof-btn-complement').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('.cof-card');
      var mainBtn = card.querySelector('.cof-btn-main');
      var priceEl = card.querySelector('.cof-prices .now');
      var oldPriceEl = card.querySelector('.cof-price-old');
      var advantageEl = card.querySelector('.cof-advantage-final');
      var isActive = btn.classList.contains('is-active');

      if (!mainBtn || !priceEl) return;

      if (!isActive) {
        btn.classList.add('is-active');
        btn.textContent = btn.dataset.labelActive;

        priceEl.textContent = btn.dataset.priceTotal;
        priceEl.classList.add('is-updated');

        mainBtn.dataset.url = btn.dataset.urlComplete;
        mainBtn.disabled = btn.dataset.availableComplete !== 'true';
        mainBtn.textContent = mainBtn.disabled
          ? 'Coffret complet indisponible'
          : mainBtn.dataset.labelDefault;

        if (oldPriceEl) {
          oldPriceEl.textContent = oldPriceEl.dataset.priceComplete;
          oldPriceEl.style.display = oldPriceEl.dataset.showComplete === 'true' ? '' : 'none';
        }

        if (advantageEl) {
          advantageEl.textContent = advantageEl.dataset.advantageComplete;
          advantageEl.style.display = advantageEl.dataset.showComplete === 'true' ? '' : 'none';
        }
      } else {
        btn.classList.remove('is-active');
        btn.textContent = btn.dataset.labelDefault;

        priceEl.textContent = btn.dataset.priceBase;
        priceEl.classList.remove('is-updated');

        mainBtn.dataset.url = btn.dataset.urlBase;
        mainBtn.disabled = btn.dataset.availableBase !== 'true';
        mainBtn.textContent = mainBtn.disabled
          ? 'Coffret indisponible'
          : mainBtn.dataset.labelDefault;

        if (oldPriceEl) {
          oldPriceEl.textContent = oldPriceEl.dataset.priceBase;
          oldPriceEl.style.display = oldPriceEl.dataset.showBase === 'true' ? '' : 'none';
        }

        if (advantageEl) {
          advantageEl.textContent = advantageEl.dataset.advantageBase;
          advantageEl.style.display = advantageEl.dataset.showBase === 'true' ? '' : 'none';
        }
      }
    });
  });

  // Bouton principal : redirige simplement vers la fiche produit
  // du coffret (base ou complet, selon le choix du client).
  // Aucun ajout au panier n'est effectué.
  section.querySelectorAll('.cof-btn-main').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.dataset.url;
      if (!url) return;
      window.location.href = url;
    });
  });
})();
</script>

{% schema %}
{
  "name": "Les coffrets O'CAOU",
  "tag": "section",
  "class": "section-ocaou-coffrets",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Titres" },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "Prêts à offrir"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Les coffrets O'CAOU"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "5 moments, 5 besoins, 5 réponses. Pochon cadeau « O'CAOU c'est pour offrir » et livraison offerts."
    },

    { "type": "header", "content": "Lien bas de section" },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Texte du lien",
      "default": "Voir tous les coffrets"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Lien"
    },

    { "type": "header", "content": "Disposition" },
    {
      "type": "range",
