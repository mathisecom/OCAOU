{%- comment -%}
  Pages de politiques servies par Shopify (/policies/...). Sans ce gabarit, Shopify les affiche
  avec ses propres tailles : le titre du texte redoublait celui de la page et les parties
  sortaient plus grosses que sur les pages du site. On applique ici la meme echelle que la
  section des pages legales, pour que les deux se lisent pareil.
{%- endcomment -%}

{%- assign corps = policy.body -%}

{%- comment -%} Le texte redit le titre de la page : on garde ce qui suit. {%- endcomment -%}
{%- if corps contains '<h1' -%}
  {%- assign corps = corps | split: '</h1>' | last -%}
{%- endif -%}

{%- comment -%} Les textes n'emploient pas les memes niveaux : on les ramene a partie et
  sous-partie, sans jamais descendre en dessous de deux niveaux. {%- endcomment -%}
{%- if corps contains '<h4' -%}
  {%- assign corps = corps
      | replace: '<h4', '<hx' | replace: '</h4>', '</hx>'
      | replace: '<h3', '<h2' | replace: '</h3>', '</h2>'
      | replace: '<hx', '<h3' | replace: '</hx>', '</h3>' -%}
{%- elsif corps contains '<h3' -%}
  {%- assign corps = corps | replace: '<h3', '<h2' | replace: '</h3>', '</h2>' -%}
{%- endif -%}

{%- assign corps = corps | strip | replace: '&nbsp; ', ' ' | replace: ' &nbsp;', ' ' | replace: '  ', ' ' | replace: '  ', ' ' -%}

<style>
  #shopify-section-{{ section.id }} {
    --page-max-width: {{ section.settings.content_width }};
  }

  #shopify-section-{{ section.id }} .prose * + span:not(:empty) { display: inline; }

  /* Meme echelle que les pages legales du site. */
  #shopify-section-{{ section.id }} .prose h2 {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 3rem 0 0.75rem;
  }
  #shopify-section-{{ section.id }} .prose h3 {
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    font-weight: 600;
    line-height: 1.35;
    margin: 2rem 0 0.5rem;
  }
  #shopify-section-{{ section.id }} .prose h4 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 1.5rem 0 0.5rem;
  }
  #shopify-section-{{ section.id }} .prose p,
  #shopify-section-{{ section.id }} .prose li {
    font-size: 1rem;
    line-height: 1.6;
  }
  #shopify-section-{{ section.id }} .prose p { margin: 0 0 1rem; }
  #shopify-section-{{ section.id }} .prose ul,
  #shopify-section-{{ section.id }} .prose ol { margin: 0 0 1rem; }
  #shopify-section-{{ section.id }} .prose li { margin: 0 0 0.25rem; }
  #shopify-section-{{ section.id }} .prose > :first-child { margin-top: 0; }
</style>

<div class="container">
  <div class="page-spacer">
    <div class="page">
      <h1 class="h1 text-center">{{ policy.title }}</h1>

      <div class="prose">
        {{ corps }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Politique de la boutique",
  "class": "shopify-section--main-page",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Largeur du texte",
      "options": [
        { "value": "60ch", "label": "Étroite" },
        { "value": "80ch", "label": "Moyenne" },
        { "value": "100ch", "label": "Large" },
        { "value": "120ch", "label": "Très large" },
        { "value": "100%", "label": "Pleine largeur" }
      ],
      "default": "80ch"
    }
  ]
}
{% endschema %}
