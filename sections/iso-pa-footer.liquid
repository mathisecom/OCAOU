{%- comment -%}
  Pied de page O'CAOU, utilisé sur tout le site (fiches produit et reste des pages).
  - Lettre d'information : vrai formulaire client Shopify (tag « newsletter »), validé côté serveur.
  - Colonnes : menu du thème (link_list) ou liens aux adresses réelles de la boutique.
  - Réseaux sociaux : adresses tenues dans les préférences du thème (mêmes réglages que le
    reste du site), aucune adresse écrite ici.
  - RGAA : titres de niveau 2, contact en address, mailto, cibles de 44 px au mobile.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign fid = 'pa-nl-' | append: sid
  assign fb = settings.social_facebook | default: shop.brand.metafields.social_links.facebook
  assign ig = settings.social_instagram | default: shop.brand.metafields.social_links.instagram
-%}
{{ 'iso-pa-footer.css' | asset_url | stylesheet_tag }}
{%- assign f500 = settings.text_font | font_modify: 'weight', '500' -%}
{%- assign f600 = settings.text_font | font_modify: 'weight', '600' -%}
{%- if f500 -%}<style>{{ f500 | font_face: font_display: 'swap' }}</style>{%- endif -%}
{%- if f600 -%}<style>{{ f600 | font_face: font_display: 'swap' }}</style>{%- endif -%}
<div class="iso-pa">
<footer class="pa-ft">
<div class="pa-ft-c" style="background:{{ section.settings.bg_color | default: '#F4EDE1' }}"><div class="pa-w">
  <div class="pa-nl">
    <h2 class="pa-h2" id="pa-nl-h-{{ sid }}">{{ section.settings.nl_titre | escape }}</h2>
    {%- form 'customer', id: fid, class: 'pa-nl-f' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="pa-sr" for="pa-nl-in-{{ sid }}">{{ section.settings.nl_champ | escape }}</label>
      <input id="pa-nl-in-{{ sid }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ section.settings.nl_champ | escape }}" required>
      <button type="submit">{{ section.settings.nl_bouton | escape }}</button>
      {%- if form.posted_successfully? -%}
        <p class="pa-nl-msg" role="status">Inscription enregistrée.</p>
      {%- elsif form.errors -%}
        <div class="pa-nl-msg pa-nl-msg--err" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
    {%- endform -%}
  </div>
  <div class="pa-ft-cols">
    {%- for block in section.blocks -%}
      {%- if block.type != 'colonne' -%}{%- continue -%}{%- endif -%}
      <div class="pa-ft-col" {{ block.shopify_attributes }}><h2 class="pa-h3">{{ block.settings.titre | escape }}</h2><ul>
        {%- if block.settings.menu != blank -%}
          {%- for link in linklists[block.settings.menu].links -%}<li><a href="{{ link.url }}">{{ link.title | strip | escape }}</a></li>{%- endfor -%}
        {%- endif -%}
        {%- for i in (1..6) -%}
          {%- assign kt = 'lien_' | append: i | append: '_texte' -%}
          {%- assign ku = 'lien_' | append: i | append: '_url' -%}
          {%- if block.settings[kt] != blank and block.settings[ku] != blank -%}<li><a href="{{ block.settings[ku] }}">{{ block.settings[kt] | escape }}</a></li>{%- endif -%}
        {%- endfor -%}
      </ul></div>
    {%- endfor -%}
    <div class="pa-ft-col pa-ft-col--ct"><h2 class="pa-h3">Contact</h2><address>{% if section.settings.email != blank %}<a class="pa-ft-mail" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a><br>{% endif %}{{ section.settings.adresse | escape }}</address></div>
  </div>
  <div class="pa-ft-bot">
    {%- if section.settings.pays_visible -%}
      <div class="pa-ft-pays">
        <span>Livraison&nbsp;:</span>
        {%- render 'localization-selector', type: 'country', show_country_name: true, show_country_flag: true, popover_horizontal_position: 'start' -%}
      </div>
    {%- endif -%}
    {%- if fb != blank or ig != blank -%}
      <ul class="pa-ft-soc">
        {%- if fb != blank -%}<li><a href="{{ fb }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: social_media: 'Facebook' }}">{%- render 'icon' with 'facebook', width: 20, height: 20 -%}</a></li>{%- endif -%}
        {%- if ig != blank -%}<li><a href="{{ ig }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.follow_on' | t: social_media: 'Instagram' }}">{%- render 'icon' with 'instagram', width: 20, height: 20 -%}</a></li>{%- endif -%}
      </ul>
    {%- endif -%}
    <ul class="pa-ft-leg">
      {%- for i in (1..3) -%}
        {%- assign kt = 'legal_' | append: i | append: '_texte' -%}
        {%- assign ku = 'legal_' | append: i | append: '_url' -%}
        {%- if section.settings[kt] != blank and section.settings[ku] != blank -%}<li><a href="{{ section.settings[ku] }}">{{ section.settings[kt] | escape }}</a></li>{%- endif -%}
      {%- endfor -%}
      {%- if section.settings.cookies_texte != blank -%}
        <li><button type="button" class="pa-ft-cookies" hidden>{{ section.settings.cookies_texte | escape }}</button></li>
      {%- endif -%}
    </ul>
    <p>© {{ 'now' | date: '%Y' }} Tous droits réservés · {{ section.settings.marque | default: shop.name | escape }}</p>
  </div>
</div></div>
</footer>
</div>

{%- if section.settings.cookies_texte != blank -%}
  {%- comment -%}
    Le bouton reste caché tant que la fenêtre de préférences de Shopify n'a pas répondu :
    un lien qui n'ouvre rien vaut moins que pas de lien du tout.
  {%- endcomment -%}
  <script>
    (function () {
      var bouton = document.querySelector('#shopify-section-{{ section.id }} .pa-ft-cookies');
      if (!bouton) return;
      function brancher() {
        if (!window.privacyBanner || typeof window.privacyBanner.showPreferences !== 'function') return false;
        bouton.hidden = false;
        bouton.addEventListener('click', function () { window.privacyBanner.showPreferences(); });
        return true;
      }
      if (brancher()) return;
      var essais = 0;
      var minuteur = setInterval(function () {
        if (brancher() || ++essais > 20) clearInterval(minuteur);
      }, 500);
    })();
  </script>
{%- endif -%}

