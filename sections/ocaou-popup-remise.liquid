{%- comment -%}
  O'CAOU 16/10 : popup d'inscription, 10 % sur la première commande.
  Se déclenche après quelques secondes de navigation cumulées (pas à l'arrivée), jamais devant la bannière cookies.
  Inscrit = tag « newsletter » + « popup-remise » (le second sert de déclencheur au mail du code, côté Brevo).
  Réglage « Actif » décoché : rien ne s'affiche pour les visiteurs. Test : ajouter ?popup-test à l'adresse d'une page.
{%- endcomment -%}
{%- unless request.page_type == 'captcha' or request.page_type == 'password' or request.page_type == 'cart' or customer -%}
  {%- assign envoye = false -%}
  {%- assign en_erreur = false -%}
  {%- capture _temporaire -%}
    {%- form 'customer', id: 'ocaou-pr-form' -%}
      {%- assign envoye = form.posted_successfully? -%}
      {%- if form.errors -%}{%- assign en_erreur = true -%}{%- endif -%}
    {%- endform -%}
  {%- endcapture -%}

  <div id="ocaou-pr" class="ocaou-pr" data-actif="{{ section.settings.actif }}" data-delai="{{ section.settings.delai }}" {% if envoye %}data-envoye{% elsif en_erreur %}data-erreur{% endif %}>
    <dialog class="ocaou-pr__dialog" aria-labelledby="ocaou-pr-titre">
      <div class="ocaou-pr__corps">
        <h2 id="ocaou-pr-titre" class="ocaou-pr__titre">{{ section.settings.titre }}</h2>
        <p class="ocaou-pr__texte">{{ section.settings.texte }}</p>

        {%- form 'customer', id: 'ocaou-pr-form', class: 'ocaou-pr__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="ocaou-pr__merci" role="status">{{ section.settings.merci }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="ocaou-pr__erreur" role="alert">{{ section.settings.erreur }}</p>
            {%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter,popup-remise">
            <label class="ocaou-pr__etiquette" for="ocaou-pr-prenom">{{ section.settings.prenom }}</label>
            <input id="ocaou-pr-prenom" class="ocaou-pr__champ" type="text" name="contact[first_name]" placeholder="{{ section.settings.prenom | escape }}" autocomplete="given-name" maxlength="60">
            <label class="ocaou-pr__etiquette" for="ocaou-pr-mail">{{ section.settings.mail }}</label>
            <input id="ocaou-pr-mail" class="ocaou-pr__champ" type="email" name="contact[email]" placeholder="{{ section.settings.mail | escape }}" autocomplete="email" required>
            <button type="submit" class="ocaou-pr__bouton">{{ section.settings.bouton }}</button>
            <p class="ocaou-pr__mention">{{ section.settings.mention }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="ocaou-pr__visuel" aria-hidden="true">
        <img class="ocaou-pr__img-bureau" data-src="{% if section.settings.image_bureau != blank %}{{ section.settings.image_bureau | image_url }}{% else %}{{ 'ocaou-popup-bienvenue-2.webp' | file_url }}{% endif %}" alt="" width="480" height="640" decoding="async">
        <img class="ocaou-pr__img-mobile" data-src="{% if section.settings.image_mobile != blank %}{{ section.settings.image_mobile | image_url }}{% else %}{{ 'ocaou-popup-bienvenue-mobile.webp' | file_url }}{% endif %}" alt="" width="760" height="400" decoding="async">
      </div>

      <form method="dialog" class="ocaou-pr__fermer-form">
        <button type="submit" class="ocaou-pr__fermer" aria-label="{{ 'general.accessibility.close' | t | escape }}">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false"><path d="M1.5 1.5l11 11m0-11l-11 11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </form>
    </dialog>
  </div>

  <style>
    .ocaou-pr__dialog {
      position: fixed; inset: 0; margin: auto; padding: 0; border: 0; overflow: hidden;
      width: min(720px, calc(100vw - 32px)); max-width: none; max-height: calc(100dvh - 32px);
      border-radius: var(--rounded-lg, 1.5rem); background: rgb(244 237 225); color: #333; font-family: var(--text-font-family, Poppins, sans-serif);
    }
    .ocaou-pr__dialog[open] { display: grid; grid-template-columns: 1fr 1fr; min-height: 480px; animation: ocaou-pr-entree .25s ease-out; }
    .ocaou-pr__dialog::backdrop { background: rgba(255, 255, 255, .62); }
    html:has(.ocaou-pr__dialog[open]) { overflow: hidden; }
    @keyframes ocaou-pr-entree { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

    .ocaou-pr__corps { display: flex; flex-direction: column; justify-content: center; gap: 17px; padding: 34px 29px; text-align: center; overflow-y: auto; }
    .ocaou-pr__titre { margin: 0; font-family: var(--heading-font-family, Poppins, sans-serif); font-size: 26px; font-weight: 600; line-height: 1.3; color: #333; }
    .ocaou-pr__texte { margin: 0; font-size: 17px; line-height: 1.5; color: #333; }
    .ocaou-pr__form { display: flex; flex-direction: column; gap: 10px; margin: 0; }
    .ocaou-pr__etiquette { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .ocaou-pr__champ {
      box-sizing: border-box; width: 100%; height: 53px; padding: 0 24px; border: 1px solid #d9cfbd; border-radius: var(--rounded-button, 3.75rem);
      background: #fff; color: #333; font: inherit; font-size: 16px; outline: none; box-shadow: none; transition: border-color .15s;
    }
    .ocaou-pr__champ::placeholder { color: #666; opacity: 1; }
    .ocaou-pr__champ:focus { border-color: rgb(var(--button-background-primary, 205 148 56)); outline: none; box-shadow: none; }
    .ocaou-pr__bouton {
      box-sizing: border-box; height: 53px; margin-top: 5px; border: 2px solid rgb(var(--button-background-primary, 205 148 56)); border-radius: var(--rounded-button, 3.75rem); background: rgb(var(--button-background-primary, 205 148 56)); color: #1a1a1a; cursor: pointer;
      font: inherit; font-size: 16px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; outline: none; box-shadow: none; transition: border-color .15s, background-color .15s;
    }
    .ocaou-pr__bouton:hover { background: #b8802a; border-color: #b8802a; }
    .ocaou-pr__bouton:focus-visible { border-color: #333; outline: none; box-shadow: none; }
    .ocaou-pr__bouton[disabled] { opacity: .6; cursor: default; }
    .ocaou-pr__mention { margin: 5px 0 0; font-size: 13px; line-height: 1.45; color: #555; }
    .ocaou-pr__merci { margin: 0; padding: 17px 0; font-size: 18px; font-weight: 600; line-height: 1.4; color: #333; }
    .ocaou-pr__erreur { margin: 0; font-size: 15px; line-height: 1.4; color: #9b2c2c; }

    .ocaou-pr__visuel { position: relative; min-height: 0; background: rgb(244 237 225); }
    .ocaou-pr__img-mobile { display: none; }
    .ocaou-pr__visuel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }

    .ocaou-pr__fermer-form { position: absolute; top: 12px; right: 12px; margin: 0; }
    .ocaou-pr__fermer {
      display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 8px solid transparent; border-radius: 50%;
      background: #fff; background-clip: padding-box; color: #333; cursor: pointer; outline: none; box-shadow: none; transition: border-color .15s;
    }
    .ocaou-pr__fermer:focus-visible { border-color: #cd9438; background-clip: border-box; outline: none; box-shadow: none; }

    @media (max-width: 639px) {
      .ocaou-pr__dialog { width: min(460px, calc(100vw - 16px)); max-height: calc(100dvh - 24px); }
      .ocaou-pr__dialog[open] { display: flex; flex-direction: column; min-height: 0; overflow-y: auto; }
      .ocaou-pr__visuel { order: -1; flex: 0 0 auto; aspect-ratio: 19 / 10; }
      .ocaou-pr__img-bureau { display: none; }
      .ocaou-pr__img-mobile { display: block; }
      .ocaou-pr__visuel img { object-position: 50% 50%; }
      .ocaou-pr__corps { flex: 0 0 auto; gap: 12px; padding: 24px 22px 26px; overflow: visible; }
      .ocaou-pr__titre { font-size: 24px; }
      .ocaou-pr__texte { font-size: 16px; }
      .ocaou-pr__champ, .ocaou-pr__bouton { height: 52px; }
      .ocaou-pr__bouton { font-size: 14px; }
      .ocaou-pr__mention { font-size: 12px; }
      .ocaou-pr__fermer-form { top: 8px; right: 8px; }
    }
    @media (max-width: 639px) and (max-height: 720px) { .ocaou-pr__visuel { aspect-ratio: 19 / 7; } }
    @media (prefers-reduced-motion: reduce) { .ocaou-pr__dialog[open] { animation: none; } }
  </style>

  <script>
    (function () {
      var racine = document.getElementById('ocaou-pr');
      if (!racine) return;
      var dlg = racine.querySelector('dialog');
      if (!dlg || typeof dlg.showModal !== 'function') return;
      var K_FERME = 'ocaou:popup-remise:ferme', K_INSCRIT = 'ocaou:popup-remise:inscrit', K_TEMPS = 'ocaou:popup-remise:temps';
      var test = /[?&]popup-test(=|&|$)/.test(location.search);
      function lire(s, k) { try { return s.getItem(k); } catch (e) { return null; } }
      function ecrire(s, k, v) { try { s.setItem(k, v); } catch (e) {} }

      function ouvrir() {
        var imgs = dlg.querySelectorAll('img[data-src]');
        for (var i = 0; i < imgs.length; i++) {
          if (getComputedStyle(imgs[i]).display === 'none') continue;
          imgs[i].src = imgs[i].getAttribute('data-src'); imgs[i].removeAttribute('data-src');
        }
        dlg.showModal();
      }
      dlg.addEventListener('close', function () { if (!racine.hasAttribute('data-envoye')) ecrire(localStorage, K_FERME, String(Date.now())); });
      dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
      var form = dlg.querySelector('form.ocaou-pr__form');
      if (form) form.addEventListener('submit', function () {
        var b = form.querySelector('button[type=submit]');
        if (b) setTimeout(function () { b.disabled = true; }, 0);
      });

      if (racine.hasAttribute('data-envoye')) { ecrire(localStorage, K_INSCRIT, '1'); ouvrir(); return; }
      if (racine.hasAttribute('data-erreur')) { ouvrir(); return; }

      if (!test) {
        if (racine.getAttribute('data-actif') !== 'true') return;
        if (lire(localStorage, K_INSCRIT)) return;
        var ferme = Number(lire(localStorage, K_FERME)) || 0;
        if (ferme && Date.now() - ferme < 14 * 864e5) return;
      }

      var delai = test ? 1 : (Number(racine.getAttribute('data-delai')) || 8);
      var ecoule = test ? 0 : (Number(lire(sessionStorage, K_TEMPS)) || 0);
      /* Temps de navigation cumulé sur la session, onglet visible seulement ; on attend si la bannière cookies ou un autre volet est ouvert. */
      var minuteur = setInterval(function () {
        if (document.visibilityState !== 'visible') return;
        ecoule += 1;
        ecrire(sessionStorage, K_TEMPS, String(ecoule));
        if (ecoule < delai) return;
        if (!test && document.querySelector('[id^="shopify-pc__"], dialog[open], .drawer[open]')) return;
        clearInterval(minuteur);
        ouvrir();
      }, 1000);
    })();
  </script>
{%- endunless -%}

{% schema %}
{
  "name": "Popup remise 10 %",
  "settings": [
    { "type": "checkbox", "id": "actif", "label": "Actif", "default": false },
    { "type": "range", "id": "delai", "min": 3, "max": 30, "step": 1, "unit": "s", "label": "Délai de navigation avant affichage", "default": 8 },
    { "type": "image_picker", "id": "image_bureau", "label": "Image ordinateur (vertical 3:4, GIF ou WebP animé)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image mobile (rectangle 19:10, GIF ou WebP animé)" },
    { "type": "text", "id": "titre", "label": "Titre", "default": "-10 % sur votre première commande" },
    { "type": "textarea", "id": "texte", "label": "Texte", "default": "Vous voulez vous faire plaisir ou gâter vos proches avec nos essentiels pour bébé et maman." },
    { "type": "text", "id": "prenom", "label": "Champ prénom", "default": "Votre prénom" },
    { "type": "text", "id": "mail", "label": "Champ email", "default": "Votre email" },
    { "type": "text", "id": "bouton", "label": "Bouton", "default": "Je m'inscris" },
    { "type": "textarea", "id": "mention", "label": "Mention", "default": "En vous inscrivant, vous acceptez de recevoir nos nouveautés et nos bons plans par mail. Vous pouvez vous désinscrire à tout moment." },
    { "type": "text", "id": "merci", "label": "Message de confirmation", "default": "Merci, votre code arrive par mail." },
    { "type": "text", "id": "erreur", "label": "Message d'erreur", "default": "Adresse non valide. Vérifiez-la et réessayez." }
  ]
}
{% endschema %}
