{%- comment -%}
  Piste A : bandeau pleine largeur, titre posé sur la photo.
  Arbitrages :
  - RGAA : voile réglable sur la photo pour tenir le contraste du texte blanc (défaut 35 %),
    texte alternatif administrable, titre en <h2> pour garder la hiérarchie de la fiche.
  - Éco : une seule image, aucun script, aucune police supplémentaire.
  - Perf : chargement différé, largeurs multiples servies selon l'écran.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="iso-pa">
<section class="pa-ban" aria-labelledby="pa-ban-h-{{ section.id }}">
  {%- if s.image -%}
    {%- render 'iso-pa-img', image: s.image, alt: s.alt, cls: 'pa-ban-img', w: 1800, sizes: '100vw', widths: '640,960,1280,1600,2000' -%}
  {%- endif -%}
  <div class="pa-ban-voile" style="--voile:{{ s.voile | default: 35 | divided_by: 100.0 }}" aria-hidden="true"></div>
  <div class="pa-ban-txt">
    {%- if s.accroche != blank -%}<p class="pa-eyebrow pa-ban-eyebrow">{{ s.accroche | escape }}</p>{%- endif -%}
    <h2 class="pa-h2 pa-ban-h" id="pa-ban-h-{{ section.id }}">{{ s.titre | escape }}</h2>
    {%- if s.texte != blank -%}<p class="pa-lead pa-ban-l">{{ s.texte | escape }}</p>{%- endif -%}
  </div>
</section>
</div>

{% schema %}
{
  "name": "Bandeau",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "alt", "label": "Description de la photo (texte alternatif RGAA)" },
    { "type": "text", "id": "accroche", "label": "Accroche (petite majuscule)" },
    { "type": "text", "id": "titre", "label": "Titre" },
    { "type": "textarea", "id": "texte", "label": "Texte (optionnel)" },
    { "type": "range", "id": "voile", "label": "Voile sur la photo (%)", "min": 0, "max": 70, "step": 5, "default": 45, "info": "Sous 35 %, le texte blanc peut devenir illisible." }
  ],
  "presets": [ { "name": "Bandeau" } ]
}
{% endschema %}
