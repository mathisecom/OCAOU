{% doc %}
  @prompt
    créer une section pour 5 video mais sous forme de vignettes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-videos-{{ ai_gen_id }}{display:block;width:100%;padding:40px 0;background:{{ block.settings.background_color }}}.ai-videos-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:auto}.ai-videos-{{ ai_gen_id }}__title{margin:0 0 24px;text-align:center;color:{{ block.settings.text_color }};font-family:{{ block.settings.heading_font.family }},{{ block.settings.heading_font.fallback_families }};font-size:{{ block.settings.heading_size }}px}.ai-videos-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(5,1fr);gap:{{ block.settings.gap }}px}.ai-videos-{{ ai_gen_id }}__card{position:relative;aspect-ratio:9/16;padding:0;border:0;border-radius:{{ block.settings.radius }}px;overflow:hidden;background:{{ block.settings.placeholder_color }};cursor:pointer}.ai-videos-{{ ai_gen_id }}__poster,.ai-videos-{{ ai_gen_id }}__empty{display:block;width:100%;height:100%;object-fit:cover}.ai-videos-{{ ai_gen_id }}__empty{color:{{ block.settings.placeholder_text_color }}}.ai-videos-{{ ai_gen_id }}__play{position:absolute;top:50%;left:50%;width:50px;height:50px;display:grid;place-items:center;transform:translate(-50%,-50%);border-radius:50%;background:{{ block.settings.play_background }};color:{{ block.settings.play_color }}}.ai-videos-{{ ai_gen_id }}__play svg{width:20px;fill:currentColor}.ai-videos-{{ ai_gen_id }}__label{position:absolute;bottom:12px;left:12px;color:#fff;font-weight:600;text-shadow:0 1px 4px #000}.ai-videos-{{ ai_gen_id }}__dialog{position:fixed;inset:0;z-index:999;display:none;align-items:center;justify-content:center;background:#111d;padding:20px}.ai-videos-{{ ai_gen_id }}__dialog[open]{display:flex}.ai-videos-{{ ai_gen_id }}__dialog video{max-width:92vw;max-height:88vh}.ai-videos-{{ ai_gen_id }}__close{position:absolute;right:20px;top:20px;border:0;border-radius:50%;width:44px;height:44px;font-size:24px}@media(max-width:749px){.ai-videos-{{ ai_gen_id }}__inner{width:100%;padding:0 16px}.ai-videos-{{ ai_gen_id }}__grid{display:flex;overflow-x:auto;gap:{{ block.settings.gap_mobile }}px}.ai-videos-{{ ai_gen_id }}__card{flex:0 0 {{ block.settings.mobile_card_width }}%}}
{% endstyle %}
<video-thumbnails-{{ ai_gen_id }} class="ai-videos-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-videos-{{ ai_gen_id }}__inner"><h2 class="ai-videos-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2><div class="ai-videos-{{ ai_gen_id }}__grid">{% for i in (1..5) %}{% assign video_key = 'video_' | append: i %}{% assign title_key = 'title_' | append: i %}{% assign selected_video = block.settings[video_key] %}{% assign selected_title = block.settings[title_key] %}<button type="button" class="ai-videos-{{ ai_gen_id }}__card" data-index="{{ i }}" aria-label="Lire {{ selected_title | escape }}">{% if selected_video != blank %}{% if selected_video.preview_image %}<img class="ai-videos-{{ ai_gen_id }}__poster" src="{{ selected_video.preview_image | image_url: width: 700 }}" alt="{{ selected_title | escape }}" loading="lazy">{% else %}<div class="ai-videos-{{ ai_gen_id }}__empty">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<template data-template="{{ i }}">{{ selected_video | video_tag: controls: true, preload: 'metadata' }}</template>{% else %}<div class="ai-videos-{{ ai_gen_id }}__empty">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<span class="ai-videos-{{ ai_gen_id }}__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="ai-videos-{{ ai_gen_id }}__label">{{ selected_title | escape }}</span></button>{% endfor %}</div></div><dialog class="ai-videos-{{ ai_gen_id }}__dialog"><button class="ai-videos-{{ ai_gen_id }}__close" type="button" aria-label="Fermer">×</button><div class="ai-videos-{{ ai_gen_id }}__player"></div></dialog></video-thumbnails-{{ ai_gen_id }}>
<script>(()=>{class V{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.d=this.querySelector('dialog');this.p=this.querySelector('.ai-videos-{{ ai_gen_id }}__player');this.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=>{let t=this.querySelector(`[data-template="${b.dataset.index}"]`);if(t){this.p.innerHTML=t.innerHTML;this.d.showModal()}});this.querySelector('.ai-videos-{{ ai_gen_id }}__close').onclick=()=>{this.d.close();this.p.innerHTML=''}}}customElements.define('video-thumbnails-{{ ai_gen_id }}',V{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Vignettes vidéo","settings":[{"type":"text","id":"heading","label":"Titre","default":"Découvrez nos vidéos"},{"type":"range","id":"desktop_width_percent","label":"Largeur ordinateur","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"heading_size","label":"Taille du titre","min":16,"max":48,"step":1,"unit":"px","default":24},{"type":"font_picker","id":"heading_font","label":"Police du titre","default":"poppins_n6"},{"type":"video","id":"video_1","label":"Vidéo 1"},{"type":"text","id":"title_1","label":"Titre 1","default":"Vidéo 1"},{"type":"video","id":"video_2","label":"Vidéo 2"},{"type":"text","id":"title_2","label":"Titre 2","default":"Vidéo 2"},{"type":"video","id":"video_3","label":"Vidéo 3"},{"type":"text","id":"title_3","label":"Titre 3","default":"Vidéo 3"},{"type":"video","id":"video_4","label":"Vidéo 4"},{"type":"text","id":"title_4","label":"Titre 4","default":"Vidéo 4"},{"type":"video","id":"video_5","label":"Vidéo 5"},{"type":"text","id":"title_5","label":"Titre 5","default":"Vidéo 5"},{"type":"color","id":"background_color","label":"Fond","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Texte","default":"#1A1A1A"},{"type":"color","id":"placeholder_color","label":"Fond vide","default":"#F2F2F2"},{"type":"color","id":"placeholder_text_color","label":"Texte vide","default":"#666666"},{"type":"color","id":"play_background","label":"Fond lecture","default":"#FFFFFF"},{"type":"color","id":"play_color","label":"Icône lecture","default":"#1A1A1A"},{"type":"range","id":"gap","label":"Espacement","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"range","id":"gap_mobile","label":"Espacement mobile","min":0,"max":30,"step":2,"unit":"px","default":10},{"type":"range","id":"mobile_card_width","label":"Largeur mobile","min":45,"max":90,"step":5,"unit":"%","default":60},{"type":"range","id":"radius","label":"Arrondi","min":0,"max":40,"step":2,"unit":"px","default":16}],"presets":[{"name":"Vignettes vidéo"}],"tag":null,"class":"video-thumbnails-block"}{% endschema %}