{% comment %}
================================================================
  SNIPPET O'CAOU — Offres Duo integrees a la fiche produit
  Fichier : snippets/ocaou-duo-produit.liquid
  Mise a jour : 01/09/2026

  ▸ LES PRIX SONT AUTOMATIQUES
    Prix barre  = prix reel du sac (variante choisie)
                + prix reel du produit complementaire (variante choisie)
    Prix cadeau = prix reel de la fiche produit du cadeau
    -> si un tarif change dans une fiche produit Shopify,
       le bloc se met a jour tout seul, sans toucher au code.

  ▸ SEULE VALEUR MANUELLE : le prix promo du duo (duoX_prix).
    Il se modifie depuis Personnaliser > page produit >
    bloc "Liquid personnalise", sans ouvrir l'editeur de code.

  ▸ EXEMPLE D'APPEL a coller dans le bloc Liquid personnalise :

    {% render 'ocaou-duo-produit', product: product,
       titre_bloc: 'Completez avec un Indispensable :',
       seuil_livraison: 79,
       duo1_handle: 'gourde',      duo1_titre: 'Le Duo Gourde', duo1_prix: 89,
       duo1_badge: 'Le prefere ♥', duo1_cadeau_handle: 'poignee-nomade', duo1_cadeau_mot: 'OFFERTE',
       duo2_handle: 'cabas-ocaou', duo2_titre: 'Le Duo Cabas',  duo2_prix: 99,
       duo2_badge: '',             duo2_cadeau_handle: 'pochon',         duo2_cadeau_mot: 'OFFERT',
       duo3_handle: '' %}

    Laisser un handle vide ('') masque le duo correspondant.
    Laisser duoX_cadeau_handle vide retire le cadeau.
================================================================
{% endcomment %}

{%- liquid
  # ── Valeurs par defaut : utilisees uniquement si le parametre
  #    n'est pas fourni dans le bloc Liquid personnalise ──
  unless titre_bloc
    assign titre_bloc = 'Complétez avec un Indispensable :'
  endunless
  unless seuil_livraison
    assign seuil_livraison = settings.cart_free_shipping_threshold
  endunless
  unless seuil_livraison
    assign seuil_livraison = 79
  endunless

  unless duo1_handle
    assign duo1_handle = 'gourde'
  endunless
  unless duo1_titre
    assign duo1_titre = 'Le Duo Gourde'
  endunless
  unless duo1_prix
    assign duo1_prix = 89
  endunless
  unless duo1_badge
    assign duo1_badge = 'Le préféré ♥'
  endunless
  unless duo1_cadeau_handle
    assign duo1_cadeau_handle = 'poignee-nomade'
  endunless
  unless duo1_cadeau_mot
    assign duo1_cadeau_mot = 'OFFERTE'
  endunless

  unless duo2_handle
    assign duo2_handle = 'cabas-ocaou'
  endunless
  unless duo2_titre
    assign duo2_titre = 'Le Duo Cabas'
  endunless
  unless duo2_prix
    assign duo2_prix = 99
  endunless
  unless duo2_badge
    assign duo2_badge = ''
  endunless
  unless duo2_cadeau_handle
    assign duo2_cadeau_handle = 'pochon'
  endunless
  unless duo2_cadeau_mot
    assign duo2_cadeau_mot = 'OFFERT'
  endunless

  unless duo3_handle
    assign duo3_handle = ''
  endunless
  unless duo3_titre
    assign duo3_titre = ''
  endunless
  unless duo3_prix
    assign duo3_prix = 0
  endunless
  unless duo3_badge
    assign duo3_badge = ''
  endunless
  unless duo3_cadeau_handle
    assign duo3_cadeau_handle = ''
  endunless
  unless duo3_cadeau_mot
    assign duo3_cadeau_mot = 'OFFERT'
  endunless

  assign ajouter_cadeau = true
  if cadeau_hors_panier
    assign ajouter_cadeau = false
  endif

  assign couleur_accent = '#9f6b69'
  assign couleur_bordure = '#E5D8C8'
  assign couleur_fond = '#FDFBF7'
  assign couleur_vert = '#1EA97C'

  assign main_variant = product.selected_or_first_available_variant
  assign duo_uid = 'duoP-' | append: product.id
  assign seuil_cents = seuil_livraison | times: 100 | round
-%}

<style>
  #{{ duo_uid }} { margin: 18px 0; }
  #{{ duo_uid }} .duoP-titre {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  #{{ duo_uid }} .duoP-card {
    border: 1.5px dashed {{ couleur_bordure }};
    border-radius: 12px;
    background: {{ couleur_fond }};
    margin-bottom: 10px;
    overflow: hidden;
  }
  #{{ duo_uid }} .duoP-card.is-open { border-style: solid; border-color: {{ couleur_accent }}; }

  #{{ duo_uid }} .duoP-resume {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 14px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
  }
  #{{ duo_uid }} .duoP-thumb {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    overflow: hidden;
    background: #F0E9DC;
    flex: 0 0 auto;
  }
  #{{ duo_uid }} .duoP-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #{{ duo_uid }} .duoP-thumb-trio,
  #{{ duo_uid }} .duoP-thumb-duo {
    height: 48px;
    display: grid;
    gap: 3px;
    background: transparent;
    overflow: visible;
  }
  #{{ duo_uid }} .duoP-thumb-trio {
    width: 104px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  #{{ duo_uid }} .duoP-thumb-duo {
    width: 70px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  #{{ duo_uid }} .duoP-thumb-trio .duoP-mini,
  #{{ duo_uid }} .duoP-thumb-duo .duoP-mini {
    min-width: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #F0E9DC;
  }
  #{{ duo_uid }} .duoP-thumb-trio .duoP-mini img,
  #{{ duo_uid }} .duoP-thumb-duo .duoP-mini img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #{{ duo_uid }} .duoP-thumb-trio .duoP-mini.is-empty,
  #{{ duo_uid }} .duoP-thumb-duo .duoP-mini.is-empty {
    display: grid;
    place-items: center;
    font-size: 16px;
  }
  #{{ duo_uid }} .duoP-resume-txt { flex: 1; min-width: 0; }
  #{{ duo_uid }} .duoP-resume-txt .nom {
    font-size: 13.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  #{{ duo_uid }} .duoP-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    background: {{ couleur_accent }};
    color: #fff;
    padding: 2px 8px;
    border-radius: 999px;
  }
  #{{ duo_uid }} .duoP-resume-txt .prix {
    font-size: 12.5px;
    margin-top: 2px;
  }
  #{{ duo_uid }} .duoP-resume-txt .prix s { opacity: .5; margin-right: 6px; }
  #{{ duo_uid }} .duoP-resume-txt .prix b { color: {{ couleur_accent }}; font-size: 14px; }
  #{{ duo_uid }} .duoP-chevron {
    flex: 0 0 auto;
    transition: transform .2s ease;
    opacity: .5;
    font-size: 12px;
  }
  #{{ duo_uid }} .duoP-card.is-open .duoP-chevron { transform: rotate(180deg); }

  #{{ duo_uid }} .duoP-detail {
    display: none;
    padding: 0 14px 14px;
  }
  #{{ duo_uid }} .duoP-card.is-open .duoP-detail { display: block; }
  #{{ duo_uid }} .duoP-detail .lignes {
    font-size: 12px;
    opacity: .8;
    margin: 0 0 10px;
  }
  #{{ duo_uid }} .duoP-detail .lignes .l { display: flex; justify-content: space-between; gap: 12px; padding: 2px 0; }
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift {
    margin-top: 4px;
    padding-top: 7px;
    border-top: 1px dashed {{ couleur_bordure }};
    font-weight: 700;
    opacity: 1;
  }
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift s { opacity: .55; margin-right: 6px; font-weight: 400; }
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift b { color: {{ couleur_vert }}; }
  #{{ duo_uid }} .duoP-detail .ship { font-size: 12px; font-weight: 700; color: {{ couleur_vert }}; margin: 0 0 10px; }
  #{{ duo_uid }} .duoP-detail label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    margin-bottom: 5px;
  }
  #{{ duo_uid }} .duoP-detail select {
    width: 100%;
    padding: 9px 10px;
    font-size: 13px;
    border: 1px solid {{ couleur_bordure }};
    border-radius: 8px;
    background: #fff;
    margin-bottom: 10px;
  }
  #{{ duo_uid }} .duoP-btn {
    display: block;
    width: 100%;
    text-align: center;
    border: none;
    cursor: pointer;
    background: {{ couleur_accent }};
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 14px;
    border-radius: 999px;
    transition: opacity .15s ease;
  }
  #{{ duo_uid }} .duoP-btn:hover { opacity: .9; }
  #{{ duo_uid }} .duoP-btn.is-added { background: {{ couleur_vert }}; }
  #{{ duo_uid }} .duoP-btn:disabled { opacity: .6; cursor: wait; }
</style>
<style>
  #{{ duo_uid }} [hidden] { display: none !important; }
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift,
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift span { color: {{ couleur_vert }}; opacity: 1; }
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift s { color: {{ couleur_vert }}; opacity: .6; margin-right: 6px; font-weight: 400; }
  #{{ duo_uid }} .duoP-detail .lignes .duoP-gift b { color: {{ couleur_vert }}; text-transform: uppercase; letter-spacing: .02em; }
  #{{ duo_uid }} .duoP-detail .ship { color: {{ couleur_vert }}; font-weight: 700; text-transform: uppercase; }
  #{{ duo_uid }} .duoP-detail .duoP-select + label { margin-top: 10px; }
</style>

<div id="{{ duo_uid }}">
  <p class="duoP-titre">{{ titre_bloc }}</p>

  {%- for i in (1..3) -%}
    {%- liquid
      case i
        when 1
          assign d_handle = duo1_handle
          assign d_titre = duo1_titre
          assign d_prix = duo1_prix
          assign d_badge = duo1_badge
          assign d_cadeau_handle = duo1_cadeau_handle
          assign d_cadeau_mot = duo1_cadeau_mot
        when 2
          assign d_handle = duo2_handle
          assign d_titre = duo2_titre
          assign d_prix = duo2_prix
          assign d_badge = duo2_badge
          assign d_cadeau_handle = duo2_cadeau_handle
          assign d_cadeau_mot = duo2_cadeau_mot
        when 3
          assign d_handle = duo3_handle
          assign d_titre = duo3_titre
          assign d_prix = duo3_prix
          assign d_badge = duo3_badge
          assign d_cadeau_handle = duo3_cadeau_handle
          assign d_cadeau_mot = duo3_cadeau_mot
      endcase

      if d_handle == blank
        continue
      endif

      assign comp = all_products[d_handle]
      if comp == blank or comp.id == blank
        continue
      endif

      assign comp_variant = comp.selected_or_first_available_variant
      assign comp_image = comp_variant.featured_image | default: comp.featured_image
      assign main_image = main_variant.featured_image | default: product.featured_image

      assign cadeau = ''
      assign cadeau_variant = ''
      assign cadeau_image = ''
      assign cadeau_cents = 0
      if d_cadeau_handle != blank
        assign cadeau = all_products[d_cadeau_handle]
        assign cadeau_variant = cadeau.selected_or_first_available_variant
        assign cadeau_image = cadeau.featured_image
        assign cadeau_cents = cadeau_variant.price
      endif

      assign total = main_variant.price | plus: comp_variant.price
      assign duo_cents = d_prix | times: 100 | round
    -%}

    <div class="duoP-card" data-duo-index="{{ i }}" data-duo-cents="{{ duo_cents }}">
      <button type="button" class="duoP-resume" aria-expanded="false">
        {% if cadeau.id != blank %}
          <span class="duoP-thumb duoP-thumb-trio" aria-label="{{ product.title }} + {{ comp.title }} + {{ cadeau.title }}">
            <span class="duoP-mini">
              {% if main_image != blank %}
                <img class="duoP-img-main" src="{{ main_image | image_url: width: 160 }}" loading="lazy" alt="{{ product.title | escape }}">
              {% endif %}
            </span>
            <span class="duoP-mini">
              {% if comp_image != blank %}
                <img class="duoP-img-comp" src="{{ comp_image | image_url: width: 160 }}" loading="lazy" alt="{{ comp.title | escape }}">
              {% endif %}
            </span>
            <span class="duoP-mini{% if cadeau_image == blank %} is-empty{% endif %}">
              {% if cadeau_image != blank %}
                <img src="{{ cadeau_image | image_url: width: 160 }}" loading="lazy" alt="{{ cadeau.title | escape }}">
              {% else %}
                <span aria-hidden="true">🎁</span>
              {% endif %}
            </span>
          </span>
        {% else %}
          <span class="duoP-thumb" aria-label="{{ product.title }} + {{ comp.title }}">
            <span class="duoP-mini">
              {% if main_image != blank %}
                <img class="duoP-img-main" src="{{ main_image | image_url: width: 160 }}" loading="lazy" alt="{{ product.title | escape }}">
              {% endif %}
            </span>
            <span class="duoP-mini">
              {% if comp_image != blank %}
                <img class="duoP-img-comp" src="{{ comp_image | image_url: width: 160 }}" loading="lazy" alt="{{ comp.title | escape }}">
              {% endif %}
            </span>
          </span>
        {% endif %}
        <span class="duoP-resume-txt">
          <span class="nom">
            {{ d_titre }}
            {% if d_badge != blank %}<span class="duoP-badge">{{ d_badge }}</span>{% endif %}
          </span>
          <span class="prix">
            <s class="duoP-total"{% if total <= duo_cents %} hidden{% endif %}>{{ total | money }}</s>
            <b>{{ duo_cents | money }}</b> Prix Duo
          </span>
        </span>
        <span class="duoP-chevron">▼</span>
      </button>

      <div class="duoP-detail">
        <div class="lignes">
          <div class="l"><span>{{ product.title }}</span><span class="duoP-main-price">{{ main_variant.price | money }}</span></div>
          <div class="l"><span>{{ comp.title }}</span><span class="duoP-comp-price">{{ comp_variant.price | money }}</span></div>
          {% if cadeau.id != blank %}
            <div class="l duoP-gift">
              <span>🎁 {{ cadeau.title }}</span>
              <span><s>{{ cadeau_cents | money }}</s><b>{{ d_cadeau_mot }}</b></span>
            </div>
          {% endif %}
        </div>

        {% if duo_cents >= seuil_cents %}
          <p class="ship">🚚 Point relais offert</p>
        {% endif %}

        {% if product.variants.size > 1 %}
          <label for="{{ duo_uid }}-main-{{ i }}">Coloris {{ product.title }}</label>
          <select id="{{ duo_uid }}-main-{{ i }}" class="duoP-select duoP-select-main">
            {% for v in product.variants %}
              {%- assign v_image = v.featured_image | default: product.featured_image -%}
              <option
                value="{{ v.id }}"
                data-image="{% if v_image != blank %}{{ v_image | image_url: width: 180 }}{% endif %}"
                data-price="{{ v.price | money | escape }}"
                data-cents="{{ v.price }}"
                data-available="{% if v.available %}1{% else %}0{% endif %}"
                {% if v.id == main_variant.id %}selected{% endif %}
                {% unless v.available %}disabled{% endunless %}>
                {{ v.title }}{% unless v.available %} — épuisé{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        {% if comp.variants.size > 1 %}
          <label for="{{ duo_uid }}-sel-{{ i }}">Coloris {{ comp.title }}</label>
          <select id="{{ duo_uid }}-sel-{{ i }}" class="duoP-select duoP-select-comp">
            {% for v in comp.variants %}
              {%- assign v_image = v.featured_image | default: comp.featured_image -%}
              <option
                value="{{ v.id }}"
                data-image="{% if v_image != blank %}{{ v_image | image_url: width: 180 }}{% endif %}"
                data-price="{{ v.price | money | escape }}"
                data-cents="{{ v.price }}"
                data-available="{% if v.available %}1{% else %}0{% endif %}"
                {% if v.id == comp_variant.id %}selected{% endif %}
                {% unless v.available %}disabled{% endunless %}>
                {{ v.title }}{% unless v.available %} — épuisé{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        <button
          type="button"
          class="duoP-btn"
          data-duo-title="{{ d_titre | escape }}"
          data-label="Ajouter le Duo au panier"
          data-main-variant="{{ main_variant.id }}"
          data-comp-variant="{{ comp_variant.id }}"
          data-gift-name="{{ cadeau.title | escape }}"
          {% if ajouter_cadeau and cadeau_variant.id != blank %}data-gift-variant="{{ cadeau_variant.id }}"{% endif %}
          {% unless main_variant.available and comp_variant.available %}disabled{% endunless %}>
          {% if main_variant.available and comp_variant.available %}
            Ajouter le Duo au panier
          {% else %}
            Duo indisponible
          {% endif %}
        </button>
      </div>
    </div>
  {%- endfor -%}
</div>

<script>
(function () {
  var root = document.getElementById('{{ duo_uid }}');
  if (!root || root.dataset.duoInit) return;
  root.dataset.duoInit = '1';

  var KEY = '{{ duo_uid }}';
  window.OCAOU_DUO_STATE = window.OCAOU_DUO_STATE || {};
  var state = window.OCAOU_DUO_STATE[KEY];
  if (!state) { state = { open: null, comp: {} }; window.OCAOU_DUO_STATE[KEY] = state; }

  function money(cents) {
    return (cents / 100).toFixed(2).replace('.', ',') + ' €';
  }

  function selectedOption(sel) {
    return sel && sel.selectedIndex >= 0 ? sel.options[sel.selectedIndex] : null;
  }

  // Met a jour photos, prix ligne a ligne, prix barre et etat du bouton
  function refresh(card) {
    var mainSel = card.querySelector('.duoP-select-main');
    var compSel = card.querySelector('.duoP-select-comp');
    var btn = card.querySelector('.duoP-btn');
    var mainOpt = selectedOption(mainSel);
    var compOpt = selectedOption(compSel);

    if (mainOpt) {
      var mimg = card.querySelector('.duoP-img-main');
      if (mimg && mainOpt.dataset.image) mimg.src = mainOpt.dataset.image;
      var mprice = card.querySelector('.duoP-main-price');
      if (mprice && mainOpt.dataset.price) mprice.textContent = mainOpt.dataset.price;
      if (btn) btn.dataset.mainVariant = mainSel.value;
    }
    if (compOpt) {
      var cimg = card.querySelector('.duoP-img-comp');
      if (cimg && compOpt.dataset.image) cimg.src = compOpt.dataset.image;
      var cprice = card.querySelector('.duoP-comp-price');
      if (cprice && compOpt.dataset.price) cprice.textContent = compOpt.dataset.price;
      if (btn) btn.dataset.compVariant = compSel.value;
    }

    var totalEl = card.querySelector('.duoP-total');
    if (totalEl && mainOpt && compOpt) {
      var duoCents = parseInt(card.dataset.duoCents, 10);
      var t = parseInt(mainOpt.dataset.cents, 10) + parseInt(compOpt.dataset.cents, 10);
      totalEl.textContent = money(t);
      totalEl.hidden = !(t > duoCents);
    }

    if (btn) {
      var ok = (!mainOpt || mainOpt.dataset.available === '1') && (!compOpt || compOpt.dataset.available === '1');
      btn.disabled = !ok;
      if (!btn.classList.contains('is-added')) {
        btn.textContent = ok ? btn.dataset.label : 'Duo indisponible';
      }
    }
  }

  // Ouverture / fermeture des cartes
  root.querySelectorAll('.duoP-resume').forEach(function (head) {
    head.addEventListener('click', function () {
      var card = head.closest('.duoP-card');
      var wasOpen = card.classList.contains('is-open');
      root.querySelectorAll('.duoP-card').forEach(function (c) {
        c.classList.remove('is-open');
        c.querySelector('.duoP-resume').setAttribute('aria-expanded', 'false');
      });
      if (!wasOpen) {
        card.classList.add('is-open');
        head.setAttribute('aria-expanded', 'true');
        state.open = card.dataset.duoIndex;
      } else {
        state.open = null;
      }
    });
  });

  // Coloris : chaque selecteur ne touche que sa propre photo / son propre prix
  root.querySelectorAll('.duoP-select-main').forEach(function (sel) {
    sel.addEventListener('change', function () { refresh(sel.closest('.duoP-card')); });
  });
  root.querySelectorAll('.duoP-select-comp').forEach(function (sel) {
    sel.addEventListener('change', function () {
      var card = sel.closest('.duoP-card');
      state.comp[card.dataset.duoIndex] = sel.value;
      refresh(card);
    });
  });

  // Restauration des choix apres un re-rendu de la fiche (changement de coloris en haut de page)
  root.querySelectorAll('.duoP-card').forEach(function (card) {
    var idx = card.dataset.duoIndex;
    var compSel = card.querySelector('.duoP-select-comp');
    var saved = state.comp[idx];
    if (compSel && saved) {
      var opt = compSel.querySelector('option[value="' + saved + '"]');
      if (opt && !opt.disabled) compSel.value = saved;
    }
    if (state.open === idx) {
      card.classList.add('is-open');
      card.querySelector('.duoP-resume').setAttribute('aria-expanded', 'true');
    }
    refresh(card);
  });

  // Ajout au panier : sac + produit complementaire + cadeau
  root.querySelectorAll('.duoP-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var mainId = btn.dataset.mainVariant;
      var compId = btn.dataset.compVariant;
      if (!mainId || !compId) return;

      var initial = btn.dataset.label;
      btn.disabled = true;
      btn.textContent = 'Ajout en cours…';

      var items = [
        { id: parseInt(mainId, 10), quantity: 1 },
        { id: parseInt(compId, 10), quantity: 1 }
      ];
      var giftId = btn.dataset.giftVariant;
      if (giftId) {
        items.push({
          id: parseInt(giftId, 10),
          quantity: 1,
          properties: { 'Cadeau offert avec': btn.dataset.duoTitle }
        });
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function () {
        btn.classList.add('is-added');
        btn.textContent = '✓ Duo ajouté au panier';
        btn.disabled = false;
        window.OCAOUCart.refresh();
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = 'Erreur — réessayez';
        setTimeout(function () { btn.textContent = initial; }, 3000);
      });
    });
  });
})();
</script>
