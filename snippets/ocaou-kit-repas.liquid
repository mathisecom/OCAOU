{% comment %}
================================================================
  SNIPPET O'CAOU — Kit Repas Nomade (fiche produit Gourde)
  À placer dans : snippets/ocaou-kit-repas.liquid

  ▸ Même style que les Duos du sac : cartes accordéon avec
    miniature, prix, badge, détail au clic
  ▸ 3 étapes CUMULATIVES, vendues à PRIX PACK :
      Étape 1 : Gourde + Lunch box   49,90 € (🎁 poignée nomade)
      Étape 2 : + Couverts           69,90 € (🎁 pochon)
      Étape 3 : + Sac isotherme      99,90 € (🎁 poignée + pochon + livraison)
  ▸ Les totaux sont calculés avec les VRAIS prix Shopify
  ▸ Le bouton ajoute TOUS les produits de l'étape au panier
  ▸ Choix du coloris pour chaque produit à variantes

  ═══ INTÉGRATION ═══
  1. Créez ce fichier dans "snippets"
  2. Page produit Gourde > bloc "Liquid personnalisé" :
     {% render 'ocaou-kit-repas', product: product %}

  ⚠️ CADEAUX : le pochon (étapes 2-3) et la poignée nomade
  (étape 3) sont affichés comme avantages. Pour qu'ils
  arrivent à 0€ dans le panier, créez dans l'admin des
  réductions automatiques de type "achète X, Y, Z →
  produit offert". Si vous renseignez leurs handles dans
  la configuration, ils seront aussi ajoutés au panier
  automatiquement (laissez vide '' sinon).
================================================================
{% endcomment %}

{% comment %}
  ── ZONE DE CONFIGURATION ──────────────────────────────
  Remplacez les handles par ceux de VOS produits
  (fin de l'URL de la fiche produit).
{% endcomment %}
{%- liquid
  assign kit_lunchbox_handle = 'lunch-box'
  assign kit_couverts_handle = 'couverts'
  assign kit_isotherme_handle = 'sac-isotherme'

  assign gift_pochon_handle = 'pochon'
  assign gift_poignee_handle = 'poignee-nomade'

  # ── PRIX DES PACKS (en centimes : 4990 = 49,90 €) ──
  # L'ancien prix barré est calculé tout seul à partir des vrais prix produits.
  assign pack1_prix = 4990
  assign pack2_prix = 6990
  assign pack3_prix = 9990

  assign titre_bloc = 'Complétez votre Kit Repas Nomade :'
  assign couleur_accent = '#9f6b69'
  assign couleur_bordure = '#E5D8C8'
  assign couleur_fond = '#FDFBF7'
  assign couleur_vert = '#1EA97C'
  assign couleur_or = '#D9A13B'

  assign main_variant = product.selected_or_first_available_variant
  assign kit_uid = 'kitR-' | append: product.id

  assign p_lunch = all_products[kit_lunchbox_handle]
  assign p_couv = all_products[kit_couverts_handle]
  assign p_iso = all_products[kit_isotherme_handle]

  assign v_lunch = p_lunch.selected_or_first_available_variant
  assign v_couv = p_couv.selected_or_first_available_variant
  assign v_iso = p_iso.selected_or_first_available_variant
-%}

<style>
  #{{ kit_uid }} { margin: 18px 0; }
  #{{ kit_uid }} .kitR-titre {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 10px;
  }
  #{{ kit_uid }} .kitR-card {
    border: 1.5px dashed {{ couleur_bordure }};
    border-radius: 12px;
    background: {{ couleur_fond }};
    margin-bottom: 10px;
    overflow: hidden;
  }
  #{{ kit_uid }} .kitR-card.is-open { border-style: solid; border-color: {{ couleur_accent }}; }
  #{{ kit_uid }} .kitR-compact .kitR-resume { padding: 10px 12px; }
  #{{ kit_uid }} .kitR-compact .kitR-thumb { width: 34px; height: 34px; }
  #{{ kit_uid }} .kitR-compact .kitR-resume-txt .nom { font-size: 12.5px; }
  #{{ kit_uid }} .kitR-compact .kitR-badge { font-size: 9px; padding: 2px 7px; }
  #{{ kit_uid }} .kitR-compact .kitR-resume-txt .prix { font-size: 11.5px; }
  #{{ kit_uid }} .kitR-compact .kitR-resume-txt .prix b { font-size: 13px; }
  #{{ kit_uid }} .kitR-compact .kitR-resume-txt .gains { font-size: 10px; }
  #{{ kit_uid }} .kitR-compact .kitR-detail .lignes { font-size: 11px; }
  #{{ kit_uid }} .kitR-compact .kitR-detail .cadeaux { font-size: 11px; }
  #{{ kit_uid }} .kitR-compact .kitR-detail .cadeaux small { font-size: 10.5px; }
  #{{ kit_uid }} .kitR-compact .kitR-accroche { font-size: 11.5px !important; }
  #{{ kit_uid }} .kitR-compact .kitR-btn { font-size: 12px; padding: 10px 12px; }

  #{{ kit_uid }} .kitR-resume {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 14px;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font: inherit;
  }
  #{{ kit_uid }} .kitR-thumbs {
    display: flex;
    flex: 0 0 auto;
  }
  #{{ kit_uid }} .kitR-thumb {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    overflow: hidden;
    background: #F0E9DC;
    border: 2px solid #fff;
    margin-left: -10px;
  }
  #{{ kit_uid }} .kitR-thumb:first-child { margin-left: 0; }
  #{{ kit_uid }} .kitR-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

  #{{ kit_uid }} .kitR-resume-txt { flex: 1; min-width: 0; }
  #{{ kit_uid }} .kitR-resume-txt .nom {
    font-size: 13.5px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  #{{ kit_uid }} .kitR-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    background: {{ couleur_accent }};
    color: #fff;
    padding: 2px 8px;
    border-radius: 999px;
  }
  #{{ kit_uid }} .kitR-badge.or { background: {{ couleur_or }}; }
  #{{ kit_uid }} .kitR-resume-txt .prix {
    font-size: 12.5px;
    margin-top: 2px;
  }
  #{{ kit_uid }} .kitR-resume-txt .prix b { color: {{ couleur_accent }}; font-size: 14px; }
  #{{ kit_uid }} .kitR-resume-txt .gains {
    font-size: 11px;
    font-weight: 700;
    color: {{ couleur_vert }};
    margin-top: 1px;
  }
  #{{ kit_uid }} .kitR-chevron {
    flex: 0 0 auto;
    transition: transform .2s ease;
    opacity: .5;
    font-size: 12px;
  }
  #{{ kit_uid }} .kitR-card.is-open .kitR-chevron { transform: rotate(180deg); }

  #{{ kit_uid }} .kitR-detail { display: none; padding: 0 14px 14px; }
  #{{ kit_uid }} .kitR-card.is-open .kitR-detail { display: block; }
  #{{ kit_uid }} .kitR-detail .lignes {
    font-size: 12px;
    opacity: .85;
    margin: 0 0 10px;
  }
  #{{ kit_uid }} .kitR-detail .lignes .l { display: flex; justify-content: space-between; padding: 2px 0; }
  #{{ kit_uid }} .kitR-detail .cadeaux {
    font-size: 12px;
    font-weight: 600;
    margin: 0 0 10px;
  }
  #{{ kit_uid }} .kitR-detail .cadeaux div { padding: 2px 0; color: {{ couleur_vert }}; }
  #{{ kit_uid }} .kitR-detail .cadeaux small {
    display: block;
    font-weight: 400;
    color: #6b6b6b;
    padding-left: 20px;
  }
  #{{ kit_uid }} .kitR-detail label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  #{{ kit_uid }} .kitR-detail select {
    width: 100%;
    padding: 8px 10px;
    font-size: 13px;
    border: 1px solid {{ couleur_bordure }};
    border-radius: 8px;
    background: #fff;
    margin-bottom: 10px;
  }
  #{{ kit_uid }} .kitR-btn {
    display: block;
    width: 100%;
    border: none;
    cursor: pointer;
    background: {{ couleur_accent }};
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    padding: 12px 14px;
    border-radius: 999px;
    transition: opacity .15s ease;
  }
  #{{ kit_uid }} .kitR-btn:hover { opacity: .9; }
  #{{ kit_uid }} .kitR-btn.or { background: {{ couleur_or }}; }
  #{{ kit_uid }} .kitR-btn.is-added { background: {{ couleur_vert }}; }
  #{{ kit_uid }} .kitR-btn:disabled { opacity: .6; cursor: wait; }

  #{{ kit_uid }} .kitR-eco {
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    color: {{ couleur_vert }};
    margin-top: 4px;
  }
  #{{ kit_uid }} .kitR-resume-txt .gains { color: {{ couleur_vert }}; font-weight: 700; }
  #{{ kit_uid }} .kitR-detail .cadeaux, #{{ kit_uid }} .kitR-detail .cadeaux div { color: {{ couleur_vert }}; font-weight: 700; }
  #{{ kit_uid }} .kitR-detail .cadeaux small { font-weight: 400; opacity: .85; }
  #{{ kit_uid }} .kitR-resume-txt .prix s { opacity: .5; font-weight: 400; margin-left: 6px; }
  #{{ kit_uid }} .kitR-detail .cadeaux s { opacity: .6; font-weight: 400; }
</style>

<div id="{{ kit_uid }}">
  <p class="kitR-titre">{{ titre_bloc }}</p>

  {%- if p_lunch != blank and p_lunch.id != blank -%}

  {%- liquid
    assign total1 = main_variant.price | plus: v_lunch.price
    assign total2 = total1 | plus: v_couv.price
    assign total3 = total2 | plus: v_iso.price
    unless seuil_livraison
      assign seuil_livraison = settings.cart_free_shipping_threshold
    endunless
    unless seuil_livraison
      assign seuil_livraison = 79
    endunless
    assign seuil_cents = seuil_livraison | times: 100 | round

    assign g_poignee = all_products[gift_poignee_handle]
    assign g_pochon = all_products[gift_pochon_handle]
    assign vg_poignee = g_poignee.selected_or_first_available_variant
    assign vg_pochon = g_pochon.selected_or_first_available_variant
  -%}

  {%- comment -%} ═══ ÉTAPE 1 : Gourde + Lunch box ═══ {%- endcomment -%}
  <div class="kitR-card">
    <button type="button" class="kitR-resume" aria-expanded="false">
      <span class="kitR-thumbs">
        <span class="kitR-thumb" data-handle="MAIN">{% assign img_main = main_variant.featured_image | default: product.featured_image %}{% if img_main %}{{ img_main | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</span>
        <span class="kitR-thumb" data-handle="lunch">{% assign img_lunch = v_lunch.featured_image | default: p_lunch.featured_image %}{% if img_lunch %}{{ img_lunch | image_url: width: 120 | image_tag: loading: 'lazy', alt: p_lunch.title }}{% endif %}</span>
      </span>
      <span class="kitR-resume-txt">
        <span class="nom">Gourde + Lunch box</span>
        <span class="prix"><b>{{ pack1_prix | money }}</b> <s>{{ total1 | money }}</s> TTC</span>
        <span class="gains">🎁 Poignée nomade offerte {{ vg_poignee.price | money }}{% if pack1_prix >= seuil_cents %} · 🚚 LIVRAISON OFFERTE{% endif %}</span>
      </span>
      <span class="kitR-chevron">▼</span>
    </button>
    <div class="kitR-detail">
      <div class="lignes">
        <div class="l"><span>{{ product.title }}</span><span>{{ main_variant.price | money }}</span></div>
        <div class="l"><span>{{ p_lunch.title }}</span><span>{{ v_lunch.price | money }}</span></div>
      </div>
      <div class="cadeaux">
        <div>🎁 Poignée nomade O'CAOU OFFERTE <s>{{ vg_poignee.price | money }}</s>
          <small>Le clip malin pour accrocher la gourde au sac, à la poussette ou au vélo.</small>
        </div>
        {% if pack1_prix >= seuil_cents %}<div>🚚 LIVRAISON OFFERTE</div>{% endif %}
      </div>
      {% if product.variants.size > 1 %}
        <label for="{{ kit_uid }}-s1-main">Coloris gourde</label>
        <select id="{{ kit_uid }}-s1-main" data-handle="MAIN">
          {% for v in product.variants %}
            {% assign variant_img = v.featured_image | default: product.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}"{% if v.id == main_variant.id %} selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      {% if p_lunch.variants.size > 1 %}
        <label for="{{ kit_uid }}-s1-lunch">Coloris lunch box</label>
        <select id="{{ kit_uid }}-s1-lunch" data-handle="lunch">
          {% for v in p_lunch.variants %}
            {% assign variant_img = v.featured_image | default: p_lunch.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      <button type="button" class="kitR-btn" data-items='["MAIN","lunch"]'
        data-bundle="Duo Gourde + Lunch box"
        data-gifts="{% if vg_poignee.id and vg_poignee.available %}{{ vg_poignee.id }}{% endif %}"
        {% unless main_variant.available and v_lunch.available %}disabled{% endunless %}>
        {% if main_variant.available and v_lunch.available %}Ajouter ce duo au panier{% else %}Indisponible{% endif %}
      </button>
    </div>
  </div>

  {%- comment -%} ═══ ÉTAPE 2 : + Couverts ═══ {%- endcomment -%}
  {%- if p_couv != blank and p_couv.id != blank -%}
  <div class="kitR-card">
    <button type="button" class="kitR-resume" aria-expanded="false">
      <span class="kitR-thumbs">
        <span class="kitR-thumb" data-handle="MAIN">{% assign img_main = main_variant.featured_image | default: product.featured_image %}{% if img_main %}{{ img_main | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</span>
        <span class="kitR-thumb" data-handle="lunch">{% assign img_lunch = v_lunch.featured_image | default: p_lunch.featured_image %}{% if img_lunch %}{{ img_lunch | image_url: width: 120 | image_tag: loading: 'lazy', alt: p_lunch.title }}{% endif %}</span>
        <span class="kitR-thumb" data-handle="couv">{% assign img_couv = v_couv.featured_image | default: p_couv.featured_image %}{% if img_couv %}{{ img_couv | image_url: width: 120 | image_tag: loading: 'lazy', alt: p_couv.title }}{% endif %}</span>
      </span>
      <span class="kitR-resume-txt">
        <span class="nom">+ Les couverts <span class="kitR-badge or">Kit complet ★</span></span>
        <span class="prix"><b>{{ pack2_prix | money }}</b> <s>{{ total2 | money }}</s> TTC</span>
        <span class="gains">🎁 Pochon O'CAOU offert {{ vg_pochon.price | money }}{% if pack2_prix >= seuil_cents %} · 🚚 LIVRAISON OFFERTE{% endif %}</span>
      </span>
      <span class="kitR-chevron">▼</span>
    </button>
    <div class="kitR-detail">
      <div class="lignes">
        <div class="l"><span>{{ product.title }}</span><span>{{ main_variant.price | money }}</span></div>
        <div class="l"><span>{{ p_lunch.title }}</span><span>{{ v_lunch.price | money }}</span></div>
        <div class="l"><span>{{ p_couv.title }}</span><span>{{ v_couv.price | money }}</span></div>
      </div>
      <div class="cadeaux">
        <div>🎁 Pochon O'CAOU OFFERT <s>{{ vg_pochon.price | money }}</s>
          <small>100% coton, 30x40cm. Pour ranger, transporter ou offrir le Kit Repas Nomade avec soin.</small>
        </div>
        {% if pack2_prix >= seuil_cents %}<div>🚚 LIVRAISON OFFERTE</div>{% endif %}
      </div>
      {% if product.variants.size > 1 %}
        <label for="{{ kit_uid }}-s2-main">Coloris gourde</label>
        <select id="{{ kit_uid }}-s2-main" data-handle="MAIN">
          {% for v in product.variants %}
            {% assign variant_img = v.featured_image | default: product.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}"{% if v.id == main_variant.id %} selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      {% if p_lunch.variants.size > 1 %}
        <label for="{{ kit_uid }}-s2-lunch">Coloris lunch box</label>
        <select id="{{ kit_uid }}-s2-lunch" data-handle="lunch">
          {% for v in p_lunch.variants %}
            {% assign variant_img = v.featured_image | default: p_lunch.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      {% if p_couv.variants.size > 1 %}
        <label for="{{ kit_uid }}-s2-couv">Coloris couverts</label>
        <select id="{{ kit_uid }}-s2-couv" data-handle="couv">
          {% for v in p_couv.variants %}
            {% assign variant_img = v.featured_image | default: p_couv.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      <button type="button" class="kitR-btn" data-items='["MAIN","lunch","couv"]'
        data-bundle="Kit Repas Nomade + couverts"
        data-gifts="{% if vg_pochon.id and vg_pochon.available %}{{ vg_pochon.id }}{% endif %}"
        {% unless main_variant.available and v_lunch.available and v_couv.available %}disabled{% endunless %}>
        {% if main_variant.available and v_lunch.available and v_couv.available %}Ajouter ce trio au panier{% else %}Indisponible{% endif %}
      </button>
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ═══ ÉTAPE 3 : + Sac isotherme = Kit complet ═══ {%- endcomment -%}
  {%- if p_couv != blank and p_couv.id != blank and p_iso != blank and p_iso.id != blank -%}
  <div class="kitR-card kitR-compact">
    <button type="button" class="kitR-resume" aria-expanded="false">
      <span class="kitR-thumbs">
        <span class="kitR-thumb" data-handle="MAIN">{% assign img_main = main_variant.featured_image | default: product.featured_image %}{% if img_main %}{{ img_main | image_url: width: 120 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}</span>
        <span class="kitR-thumb" data-handle="lunch">{% assign img_lunch = v_lunch.featured_image | default: p_lunch.featured_image %}{% if img_lunch %}{{ img_lunch | image_url: width: 120 | image_tag: loading: 'lazy', alt: p_lunch.title }}{% endif %}</span>
        <span class="kitR-thumb" data-handle="couv">{% assign img_couv = v_couv.featured_image | default: p_couv.featured_image %}{% if img_couv %}{{ img_couv | image_url: width: 120 | image_tag: loading: 'lazy', alt: p_couv.title }}{% endif %}</span>
        <span class="kitR-thumb" data-handle="iso">{% assign img_iso = v_iso.featured_image | default: p_iso.featured_image %}{% if img_iso %}{{ img_iso | image_url: width: 120 | image_tag: loading: 'lazy', alt: p_iso.title }}{% endif %}</span>
      </span>
      <span class="kitR-resume-txt">
        <span class="nom">+ Sac isotherme <span class="kitR-badge or">Kit repas complet ★</span></span>
        <span class="prix"><b>{{ pack3_prix | money }}</b> <s>{{ total3 | money }}</s> TTC</span>
        <span class="gains">🎁 Poignée nomade OFFERTE · 🎁 Pochon OFFERT{% if pack3_prix >= seuil_cents %} · 🚚 LIVRAISON OFFERTE{% endif %}</span>
      </span>
      <span class="kitR-chevron">▼</span>
    </button>
    <div class="kitR-detail">
      <p class="kitR-accroche" style="font-size:12.5px;font-weight:600;margin:0 0 10px;">Complétez votre Kit Repas Nomade et recevez la poignée nomade O'CAOU en cadeau. 🎁</p>
      <div class="lignes">
        <div class="l"><span>{{ product.title }}</span><span>{{ main_variant.price | money }}</span></div>
        <div class="l"><span>{{ p_lunch.title }}</span><span>{{ v_lunch.price | money }}</span></div>
        <div class="l"><span>{{ p_couv.title }}</span><span>{{ v_couv.price | money }}</span></div>
        <div class="l"><span>{{ p_iso.title }}</span><span>{{ v_iso.price | money }}</span></div>
      </div>
      <div class="cadeaux">
        <div>🎁 Poignée nomade O'CAOU OFFERTE <s>{{ vg_poignee.price | money }}</s>
          <small>Le clip malin pour accrocher la gourde au sac, à la poussette ou au vélo.</small>
        </div>
        <div>🎁 Pochon O'CAOU OFFERT <s>{{ vg_pochon.price | money }}</s>
          <small>100% coton, 30x40cm. Pour ranger, transporter ou offrir le Kit Repas Nomade avec soin.</small>
        </div>
        {% if pack3_prix >= seuil_cents %}<div>🚚 LIVRAISON OFFERTE</div>{% endif %}
      </div>
      {% if product.variants.size > 1 %}
        <label for="{{ kit_uid }}-s3-main">Coloris gourde</label>
        <select id="{{ kit_uid }}-s3-main" data-handle="MAIN">
          {% for v in product.variants %}
            {% assign variant_img = v.featured_image | default: product.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}"{% if v.id == main_variant.id %} selected{% endif %} {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      {% if p_lunch.variants.size > 1 %}
        <label for="{{ kit_uid }}-s3-lunch">Coloris lunch box</label>
        <select id="{{ kit_uid }}-s3-lunch" data-handle="lunch">
          {% for v in p_lunch.variants %}
            {% assign variant_img = v.featured_image | default: p_lunch.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      {% if p_couv.variants.size > 1 %}
        <label for="{{ kit_uid }}-s3-couv">Coloris couverts</label>
        <select id="{{ kit_uid }}-s3-couv" data-handle="couv">
          {% for v in p_couv.variants %}
            {% assign variant_img = v.featured_image | default: p_couv.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      {% if p_iso.variants.size > 1 %}
        <label for="{{ kit_uid }}-s3-iso">Coloris sac isotherme</label>
        <select id="{{ kit_uid }}-s3-iso" data-handle="iso">
          {% for v in p_iso.variants %}
            {% assign variant_img = v.featured_image | default: p_iso.featured_image %}
            <option value="{{ v.id }}" data-image="{% if variant_img %}{{ variant_img | image_url: width: 240 }}{% endif %}" {% unless v.available %}disabled{% endunless %}>{{ v.title }}{% unless v.available %} — épuisé{% endunless %}</option>
          {% endfor %}
        </select>
      {% endif %}
      <button type="button" class="kitR-btn or" data-items='["MAIN","lunch","couv","iso"]'
        data-bundle="Kit Repas Nomade complet"
        data-gifts="{% if vg_poignee.id and vg_poignee.available %}{{ vg_poignee.id }}{% endif %}{% if vg_poignee.id and vg_poignee.available and vg_pochon.id and vg_pochon.available %},{% endif %}{% if vg_pochon.id and vg_pochon.available %}{{ vg_pochon.id }}{% endif %}"
        {% unless main_variant.available and v_lunch.available and v_couv.available and v_iso.available %}disabled{% endunless %}>
        {% if main_variant.available and v_lunch.available and v_couv.available and v_iso.available %}Ajouter le Kit repas complet au panier{% else %}Indisponible{% endif %}
      </button>
    </div>
  </div>
  {%- endif -%}

  <p class="kitR-eco">🎁 Profitez des cadeaux offerts avec le Kit Repas Nomade</p>

  {%- else -%}
    <p style="font-size:12px;opacity:.7">⚠️ Configurez les handles des produits dans le snippet ocaou-kit-repas.</p>
  {%- endif -%}
</div>

<script>
(function () {
  var root = document.getElementById('{{ kit_uid }}');
  if (!root || root.dataset.kitInit) return;
  root.dataset.kitInit = '1';

  // Variantes par défaut (si le produit n'a qu'une variante, pas de select)
  var defaults = {
    MAIN: '{{ main_variant.id }}',
    lunch: '{{ v_lunch.id }}',
    couv: '{{ v_couv.id }}',
    iso: '{{ v_iso.id }}'
  };

  // Mise à jour de la miniature selon la variante choisie
  function updateVariantThumb(select) {
    var card = select.closest('.kitR-card');
    if (!card) return;

    var key = select.dataset.handle;
    var option = select.options[select.selectedIndex];
    var imageUrl = option ? option.dataset.image : '';
    if (!key || !imageUrl) return;

    var img = card.querySelector('.kitR-thumb[data-handle="' + key + '"] img');
    if (!img) return;

    // image_tag génère généralement un srcset : on le retire pour forcer
    // immédiatement l'image de la variante sélectionnée.
    img.removeAttribute('srcset');
    img.removeAttribute('sizes');
    img.src = imageUrl;
  }

  root.querySelectorAll('select[data-handle]').forEach(function (select) {
    select.addEventListener('change', function () {
      updateVariantThumb(select);
    });

    // Synchronise aussi la miniature avec la variante sélectionnée au chargement.
    updateVariantThumb(select);
  });

  // Accordéon
  root.querySelectorAll('.kitR-resume').forEach(function (head) {
    head.addEventListener('click', function () {
      var card = head.closest('.kitR-card');
      var open = card.classList.contains('is-open');
      root.querySelectorAll('.kitR-card').forEach(function (c) {
        c.classList.remove('is-open');
        c.querySelector('.kitR-resume').setAttribute('aria-expanded', 'false');
      });
      if (!open) {
        card.classList.add('is-open');
        head.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Ajout groupé au panier
  root.querySelectorAll('.kitR-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var card = btn.closest('.kitR-card');
      var keys = JSON.parse(btn.dataset.items);
      var items = keys.map(function (key) {
        var sel = card.querySelector('select[data-handle="' + key + '"]');
        var id = sel ? sel.value : defaults[key];
        return { id: parseInt(id, 10), quantity: 1 };
      }).filter(function (it) { return it.id; });

      if (!items.length) return;

      // Cadeaux offerts : ajoutés au panier avec la mention "Cadeau offert avec".
      // Leur prix passe à 0 € grâce aux réductions automatiques Shopify.
      var bundleName = btn.dataset.bundle || '';
      (btn.dataset.gifts || '').split(',').forEach(function (gid) {
        gid = gid.trim();
        if (!gid) return;
        items.push({
          id: parseInt(gid, 10),
          quantity: 1,
          properties: { 'Cadeau offert avec': bundleName }
        });
      });

      var initial = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Ajout en cours…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function () {
        btn.classList.add('is-added');
        btn.textContent = '✓ Ajouté au panier';
        btn.disabled = false;
        window.OCAOUCart.refresh();
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = 'Erreur — réessayez';
        setTimeout(function () { btn.textContent = initial; }, 3000);
      });
    });
  });
})();
</script>