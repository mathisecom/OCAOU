{%- comment -%}
  ----------------------------------------------------------------------------
  snippets/product-videos.liquid
  ----------------------------------------------------------------------------
  Affiche les videos d'un produit, stockees dans un metachamp produit de type
  "Fichier (liste)". La cliente ajoute / retire / reordonne ses videos
  directement depuis la fiche produit de l'admin Shopify, sans toucher au theme.

  Parametres :
    - block   (obligatoire) : le bloc de section qui porte les reglages
    - product (obligatoire) : le produit courant
  ----------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign mf_namespace = block.settings.metafield_namespace | default: 'custom'
  assign mf_key = block.settings.metafield_key | default: 'product_videos'
  assign videos = product.metafields[mf_namespace][mf_key].value
  assign videos_count = videos.size | default: 0

  assign show_controls = block.settings.show_controls
  assign autoplay = block.settings.autoplay

  if autoplay
    assign is_muted = true
    assign is_loop = true
  else
    assign is_muted = false
    assign is_loop = false
  endif

  assign ratio = block.settings.aspect_ratio
-%}

{%- if videos_count > 0 -%}
  {%- assign uid = block.id -%}

  <style>
    .product-videos-{{ uid }} {
      display: grid;
      gap: var(--spacing-1, 8px);
    }

    .product-videos-{{ uid }} .product-videos__title {
      margin: 0;
      font-weight: 600;
    }

    .product-videos-{{ uid }} .product-videos__grid {
      display: grid;
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.gap }}px;
    }

    @media screen and (min-width: 700px) {
      .product-videos-{{ uid }} .product-videos__grid {
        grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
      }
    }

    .product-videos-{{ uid }} .product-videos__item {
      display: grid;
      gap: 6px;
      margin: 0;
      min-width: 0;
    }

    .product-videos-{{ uid }} .product-videos__frame {
      position: relative;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.04);
      border-radius: {{ block.settings.border_radius }}px;
      {%- if ratio != 'natural' %}
      aspect-ratio: {{ ratio }};
      {%- endif %}
    }

    .product-videos-{{ uid }} .product-videos__frame video,
    .product-videos-{{ uid }} .product-videos__frame img {
      display: block;
      width: 100%;
      height: 100%;
      {%- if ratio != 'natural' %}
      object-fit: cover;
      {%- else %}
      height: auto;
      {%- endif %}
    }

    .product-videos-{{ uid }} .product-videos__caption {
      font-size: 0.85em;
      opacity: 0.7;
      text-align: center;
    }
  </style>

  <div class="product-videos product-videos-{{ uid }}">
    {%- if block.settings.title != blank -%}
      <p class="product-videos__title">{{ block.settings.title | escape }}</p>
    {%- endif -%}

    <div class="product-videos__grid">
      {%- for media in videos -%}
        {%- liquid
          assign mp4_sources = media.sources | where: 'format', 'mp4'
          assign poster = media.preview_image | image_url: width: 900
        -%}

        <figure class="product-videos__item">
          <div class="product-videos__frame">
            {%- if mp4_sources.size > 0 -%}
              <video
                {% if show_controls %}controls{% endif %}
                {% if autoplay %}autoplay muted loop{% endif %}
                playsinline
                preload="metadata"
                {% if poster != blank %}poster="{{ poster }}"{% endif %}
                {% if media.alt != blank %}aria-label="{{ media.alt | escape }}"{% endif %}
              >
                {%- for source in mp4_sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {%- else -%}
              {{ media | video_tag: controls: show_controls, autoplay: autoplay, muted: is_muted, loop: is_loop, image_size: '900x' }}
            {%- endif -%}
          </div>

          {%- if block.settings.show_captions and media.alt != blank -%}
            <figcaption class="product-videos__caption">{{ media.alt | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>

{%- elsif request.design_mode -%}
  <div class="product-videos product-videos--empty">
    <p style="font-size:0.85em;opacity:.7;border:1px dashed currentColor;border-radius:8px;padding:12px;margin:0;">
      Bloc « Videos produit » : aucune video sur ce produit pour l'instant.<br>
      Ajoute-les dans la fiche produit (Admin &gt; Produits &gt; le produit &gt; section « Metachamps » &gt; {{ mf_namespace }}.{{ mf_key }}).<br>
      Ce message n'apparait que dans l'editeur de theme.
    </p>
  </div>
{%- endif -%}
