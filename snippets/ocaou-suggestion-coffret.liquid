{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
O'CAOU — REGROUPEMENT EN COFFRET
----------------------------------------------------------------------------------------------------------------------

Dans le panier, quand les articles reunis forment un coffret :

* le coffret est moins cher : le regroupement se fait tout seul, le client est informe ;
* le coffret coute plus cher parce qu'il ajoute des articles : on propose, on n'impose pas.

La table de correspondance vit dans assets/ocaou-coffrets.json, regeneree par
_scripts/ocaou-coffrets.py cote ISOMORPH. Aucun identifiant n'est ecrit en dur ici.
{%- endcomment -%}

<style>
  .ocaou-sugg {
    display: flex; align-items: center; gap: 14px;
    margin: 16px 0; padding: 14px 16px;
    border: 1px solid rgba(0,0,0,.12); border-radius: 14px;
    background: #fff; text-decoration: none; color: inherit;
  }
  .ocaou-sugg__img { flex: 0 0 auto; width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: #f3efe9; }
  .ocaou-sugg__txt { flex: 1 1 auto; min-width: 0; line-height: 1.35; }
  .ocaou-sugg__titre { font-weight: 600; margin-right: 6px; }
  .ocaou-sugg__prix { color: {{ settings.color_accent | default: '#cd9438' }}; font-weight: 600; white-space: nowrap; }
  .ocaou-sugg__barre { text-decoration: line-through; opacity: .55; margin-left: 4px; white-space: nowrap; }
  .ocaou-sugg__detail { display: block; font-size: .875em; opacity: .7; margin-top: 2px; }
  .ocaou-sugg__actions { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; }
  .ocaou-sugg__cta {
    display: inline-block; padding: 7px 14px; border-radius: 999px; border: 0; cursor: pointer;
    background: {{ settings.color_accent | default: '#cd9438' }}; color: #fff;
    font: inherit; font-size: .875em; font-weight: 600; line-height: 1.4; white-space: nowrap;
  }
  .ocaou-sugg__cta[disabled] { opacity: .6; cursor: wait; }
  .ocaou-sugg__non { border: 0; background: none; cursor: pointer; font: inherit; font-size: .875em; opacity: .55; padding: 4px; }
  .ocaou-sugg__non:hover { opacity: .9; }
  .ocaou-sugg__ok {
    display: inline-block; padding: 7px 16px; border-radius: 999px; cursor: pointer;
    border: 1px solid rgba(0,0,0,.18); background: #fff; color: inherit;
    font: inherit; font-size: .875em; font-weight: 600; line-height: 1.4; white-space: nowrap;
  }
  .ocaou-sugg__ok:hover {
    border-color: {{ settings.color_accent | default: '#cd9438' }};
    color: {{ settings.color_accent | default: '#cd9438' }};
  }
  /* Une seule action sur la carte d'information : elle se pose a droite. */
  .ocaou-sugg--info .ocaou-sugg__actions { justify-content: flex-end; }

  /* Peu de place : l'image reste a gauche du texte, les boutons passent dessous. */
  .ocaou-sugg--serre {
    display: grid; grid-template-columns: auto minmax(0, 1fr);
    column-gap: 12px; row-gap: 10px; align-items: center;
  }
  .ocaou-sugg--serre .ocaou-sugg__img { grid-column: 1; grid-row: 1; width: 40px; height: 40px; }
  .ocaou-sugg--serre .ocaou-sugg__txt { grid-column: 2; grid-row: 1; }
  .ocaou-sugg--serre .ocaou-sugg__actions { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; }
  .ocaou-sugg--serre .ocaou-sugg__cta { flex: 0 0 auto; }

  @media screen and (max-width: 749px) {
    .ocaou-sugg {
      display: grid; grid-template-columns: auto minmax(0, 1fr);
      column-gap: 12px; row-gap: 10px; align-items: center;
    }
    .ocaou-sugg__img { grid-column: 1; grid-row: 1; width: 40px; height: 40px; }
    .ocaou-sugg__txt { grid-column: 2; grid-row: 1; }
    .ocaou-sugg__actions { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; }
  }
</style>

<script>
(function () {
  var SOURCE = {{ 'ocaou-coffrets.json' | asset_url | json }};
  var table = null;
  var refuses = [];
  var enCours = false;
  var infoCourante = null;   // message de regroupement, garde tant qu'il n'est pas ferme
  try { refuses = JSON.parse(sessionStorage.getItem('ocaou-sugg-refus') || '[]'); } catch (e) {}

  function prix(centimes) {
    return (centimes / 100).toFixed(2).replace('.', ',') + ' €';
  }

  function liste(noms) {
    if (!noms.length) return '';
    if (noms.length === 1) return noms[0];
    return noms.slice(0, -1).join(', ') + ' et ' + noms[noms.length - 1];
  }

  // Tout texte venant de la table est insere par textContent, jamais par innerHTML.
  function bloc(classe, texte, balise) {
    var n = document.createElement(balise || 'span');
    n.className = classe;
    if (texte != null) n.textContent = texte;
    return n;
  }

  function carte(options) {
    var el = document.createElement('div');
    el.className = 'ocaou-sugg';
    el.setAttribute('data-ocaou-sugg', 'panier');

    if (options.image) {
      var img = document.createElement('img');
      img.className = 'ocaou-sugg__img';
      img.alt = '';
      img.loading = 'lazy';
      img.src = options.image + (options.image.indexOf('?') === -1 ? '?' : '&') + 'width=104';
      el.appendChild(img);
    }

    var txt = bloc('ocaou-sugg__txt', null, 'div');
    txt.appendChild(bloc('ocaou-sugg__titre', options.titre));
    if (options.prix != null) txt.appendChild(bloc('ocaou-sugg__prix', prix(options.prix)));
    if (options.barre) txt.appendChild(bloc('ocaou-sugg__barre', prix(options.barre)));
    if (options.detail) txt.appendChild(bloc('ocaou-sugg__detail', options.detail));
    el.appendChild(txt);

    var actions = bloc('ocaou-sugg__actions', null, 'div');
    el.appendChild(actions);
    return { el: el, actions: actions };
  }

  /* ------------------------------------------------------- reconnaissance */

  // Une ligne de panier qui est elle-meme un coffret compte pour ses articles :
  // c'est ce qui permet de reconnaitre le coffret de trois a partir d'un duo
  // plus un article. Le prix reste porte par la ligne reelle.
  function deplie(panier) {
    var entrees = [];
    panier.items.forEach(function (it) {
      var composants = null;
      table.coffrets.some(function (c) {
        var comp = c.parVariante && c.parVariante[it.variant_id];
        if (!comp) return false;
        composants = comp;
        return true;
      });
      if (composants) {
        composants.forEach(function (comp) {
          entrees.push({ produit: comp.produit, variante: comp.variante, ligne: it, issuDunCoffret: true });
        });
      } else {
        entrees.push({ produit: it.product_id, variante: it.variant_id, ligne: it, issuDunCoffret: false });
      }
    });
    return entrees;
  }

  // Tous les coffrets que le panier peut former, un par un.
  function candidats(panier) {
    // Les articles achetes seuls passent avant ceux d'un coffret deja au panier :
    // on ne defait pas un coffret quand un article libre fait l'affaire.
    var deplies = deplie(panier).sort(function (a, b) {
      return (a.issuDunCoffret ? 1 : 0) - (b.issuDunCoffret ? 1 : 0);
    });
    var trouves = [];

    for (var i = 0; i < table.coffrets.length; i++) {
      var c = table.coffrets[i];
      var dejaAuPanier = panier.items.some(function (it) { return it.product_id === c.id; });

      var pris = [];
      var variantes = [];
      var complet = c.articles.every(function (produitId) {
        var e = deplies.find(function (d) {
          return d.produit === produitId && pris.indexOf(d) === -1;
        });
        if (!e) return false;
        pris.push(e);
        variantes.push(e.variante);
        return true;
      });
      if (!complet) continue;

      var cle = variantes.slice().sort(function (a, b) { return a - b; }).join('-');
      var combi = c.combinaisons[cle];
      if (!combi || !combi.dispo) continue;

      // Les articles compris d'office dans le coffret sortent aussi du panier.
      // Un article venant d'un coffret deja au panier n'est repris que si ce coffret
      // est deja en train d'etre absorbe : on ne pioche pas dans un coffret intact.
      var lignes = [];
      pris.forEach(function (d) { if (lignes.indexOf(d.ligne) === -1) lignes.push(d.ligne); });
      // Un seul exemplaire par article compris, pris d'abord dans ce qui part deja.
      c.inclus.forEach(function (inc) {
        var libres = deplies.filter(function (d) {
          return pris.indexOf(d) === -1 && d.variante === inc.variante &&
                 (!d.issuDunCoffret || lignes.indexOf(d.ligne) !== -1);
        });
        var d = libres.find(function (x) { return lignes.indexOf(x.ligne) !== -1; }) || libres[0];
        if (!d) return;
        pris.push(d);
        if (lignes.indexOf(d.ligne) === -1) lignes.push(d.ligne);
      });

      // Le coffret deja au panier, seul : rien a regrouper.
      if (lignes.length === 1 && lignes[0].product_id === c.id) continue;

      // Les cadeaux poses par les blocs de packs maison partent avec le regroupement :
      // le coffret officiel porte ses propres cadeaux, sinon le client se retrouve
      // avec une poignee facturee alors qu'elle lui etait annoncee offerte.
      deplies.forEach(function (d) {
        if (pris.indexOf(d) !== -1) return;
        var props = d.ligne.properties || {};
        var cadeau = Object.keys(props).some(function (k) { return /cadeau offert/i.test(k); });
        if (!cadeau) return;
        pris.push(d);
        if (lignes.indexOf(d.ligne) === -1) lignes.push(d.ligne);
      });

      // Un coffret deja au panier ne se defait que s'il est absorbe en entier.
      var entier = lignes.every(function (ligne) {
        var total = deplies.filter(function (d) { return d.ligne === ligne; });
        return total.every(function (d) { return pris.indexOf(d) !== -1; });
      });
      if (!entier) continue;

      // Un seul exemplaire de chaque article part dans le coffret : on compare au
      // prix unitaire, meme si la ligne du panier en contient plusieurs.
      var actuel = lignes.reduce(function (t, l) { return t + l.final_price; }, 0);

      var dejaLa = pris.map(function (d) { return d.variante; });
      var enPlus = c.inclus.filter(function (inc) { return dejaLa.indexOf(inc.variante) === -1; })
                           .map(function (inc) { return { nom: inc.nom, offert: !!inc.offert, prix: inc.prix || 0 }; });

      // L'avantage annonce compte aussi la valeur de ce que le coffret ajoute, cadeaux compris.
      // Le regroupement automatique, lui, ne se declenche que si le panier coute moins cher.
      var valeurAjoutee = enPlus.reduce(function (t, i) { return t + i.prix; }, 0);

      if (combi.prix >= actuel && !enPlus.length) continue;
      // Un coffret plus cher ne se propose pas a qui l'a deja.
      if (combi.prix >= actuel && dejaAuPanier) continue;

      // Le message du panier reprend le calcul de la fiche coffret : prix barre moins
      // prix, plus la valeur de tous les cadeaux, deja au panier ou non.
      var cadeaux = c.inclus.filter(function (inc) { return inc.offert; })
                            .map(function (inc) { return { nom: inc.nom, offert: true, prix: inc.prix || 0 }; });
      var annonce = Math.max(0, (combi.prixBarre || 0) - combi.prix) +
                    cadeaux.reduce(function (t, i) { return t + i.prix; }, 0);

      trouves.push({
        coffret: c, combi: combi, lignes: lignes, actuel: actuel,
        economie: actuel - combi.prix,
        avantage: actuel - combi.prix + valeurAjoutee,
        enPlus: enPlus, cadeaux: cadeaux, annonce: annonce
      });
    }
    return trouves;
  }

  // Le panier tel qu'il serait apres ce regroupement.
  function applique(panier, trouve) {
    var items = [];
    panier.items.forEach(function (it) {
      if (trouve.lignes.indexOf(it) === -1) { items.push(it); return; }
      if (it.quantity > 1) items.push(Object.assign({}, it, { quantity: it.quantity - 1 }));
    });
    items.push({
      product_id: trouve.coffret.id, variant_id: trouve.combi.variante,
      final_price: trouve.combi.prix, quantity: 1, properties: {}
    });
    return { items: items };
  }

  // Plusieurs coffrets possibles : on garde l'enchainement qui fait payer le moins,
  // puis, a prix egal, celui qui offre le plus.
  function meilleur(panier, profondeur) {
    var rien = { economie: 0, avantage: 0, premier: null };
    if (profondeur > 6 || panier.items.length < 2) return rien;
    var mieux = rien;
    candidats(panier).forEach(function (t) {
      if (t.economie <= 0) return;
      var suite = meilleur(applique(panier, t), profondeur + 1);
      var total = { economie: t.economie + suite.economie, avantage: t.avantage + suite.avantage, premier: t };
      if (total.economie > mieux.economie ||
          (total.economie === mieux.economie && total.avantage > mieux.avantage)) mieux = total;
    });
    return mieux;
  }

  // Un regroupement moins cher d'abord ; sinon, le plus grand coffret a proposer.
  function chercheCoffret(panier) {
    var plan = meilleur(panier, 0);
    var t = plan.premier || candidats(panier)[0] || null;
    if (t) t.panier = panier;
    return t;
  }

  /* ------------------------------------------------------------ echange */

  // Les articles repris partent en un seul envoi, et le coffret n'est ajoute que si
  // le panier renvoye confirme leur depart : sinon le client paierait deux fois.
  function echange(trouve) {
    var updates = {}, attendu = {}, avant = {};
    trouve.panier.items.forEach(function (it) {
      avant[it.variant_id] = (avant[it.variant_id] || 0) + it.quantity;
    });
    trouve.lignes.forEach(function (l) {
      updates[l.key] = Math.max(0, (updates[l.key] === undefined ? l.quantity : updates[l.key]) - 1);
      attendu[l.variant_id] = (attendu[l.variant_id] === undefined ? avant[l.variant_id] : attendu[l.variant_id]) - 1;
    });
    return fetch(window.Shopify.routes.root + 'cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ updates: updates })
    })
      .then(function (r) { if (!r.ok) throw new Error('panier'); return r.json(); })
      .then(function (panier) {
        var reste = {};
        panier.items.forEach(function (it) { reste[it.variant_id] = (reste[it.variant_id] || 0) + it.quantity; });
        var confirme = Object.keys(attendu).every(function (v) { return (reste[v] || 0) === attendu[v]; });
        if (!confirme) throw new Error('panier');
        var lignes = [{ id: trouve.combi.variante, quantity: 1 }];
        if (window.OCAOUCart && window.OCAOUCart.add) return window.OCAOUCart.add(lignes);
        return fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: lignes })
        });
      });
  }

  // Les regroupements s'enchainent : le message les annonce tous ensemble.
  function infosEnAttente() {
    var liste = [];
    try { liste = JSON.parse(sessionStorage.getItem('ocaou-sugg-info') || '[]') || []; } catch (e) {}
    if (!Array.isArray(liste)) liste = [liste];
    if (infoCourante) liste = infoCourante.concat(liste);
    // Un meme coffret ne s'annonce qu'une fois, meme si le panier a ete relu plusieurs fois.
    return liste.filter(function (i, n) {
      return !liste.slice(n + 1).some(function (j) { return j.titre === i.titre; });
    });
  }

  // Coffrets deja vus dans ce panier : un cadeau ajoute apres son coffret est un achat
  // voulu et reste un produit a part. Seul un cadeau present avant le coffret est repris.
  var CLE_VUS = 'ocaou-coffrets-vus';
  function lisVus(panier) {
    var m = null;
    try { m = JSON.parse(localStorage.getItem(CLE_VUS) || 'null'); } catch (e) {}
    return m && m.token === panier.token ? m : null;
  }
  function ecrisVus(m) {
    try { localStorage.setItem(CLE_VUS, JSON.stringify(m)); } catch (e) {}
  }

  function apres(trouve) {
    var infos = infosEnAttente();
    infoCourante = null;
    infos.push({
      titre: trouve.coffret.titre,
      economie: trouve.economie,
      avantage: trouve.annonce,
      offerts: trouve.enPlus.filter(function (i) { return !i.offert; }).concat(trouve.cadeaux),
      image: trouve.coffret.image
    });
    try { sessionStorage.setItem('ocaou-sugg-info', JSON.stringify(infos)); } catch (e) {}
    // Le coffret forme ici a deja repris ses cadeaux : il compte comme vu.
    try {
      var m = JSON.parse(localStorage.getItem(CLE_VUS) || 'null');
      if (m) {
        m.formes = m.formes || {};
        m.formes[trouve.combi.variante] = (m.formes[trouve.combi.variante] || 0) + 1;
        ecrisVus(m);
      }
    } catch (e) {}
    var surLaPagePanier = window.location.pathname.indexOf('/cart') !== -1;
    if (!surLaPagePanier && window.OCAOUCart && window.OCAOUCart.add) { enCours = false; passe(); return; }
    window.location.reload();
  }

  /* ------------------------------------------------------------- cartes */

  // Seuls le pochon et la poignee sont des cadeaux. Les autres articles du coffret
  // s'annoncent sans mention : ils sont compris dans le prix, pas offerts.
  // « OFFERT » sert d'etiquette : place devant, il n'a pas a s'accorder avec la liste.
  function mentionAjouts(items) {
    if (!items || !items.length) return null;
    var cadeaux = [], compris = [];
    var nombre = {};
    items.forEach(function (i) {
      if (nombre[i.nom]) { nombre[i.nom]++; return; }
      nombre[i.nom] = 1;
      (i.offert ? cadeaux : compris).push(i.nom);
    });
    function compte(nom) { return nombre[nom] > 1 ? nom + ' × ' + nombre[nom] : nom; }
    cadeaux = cadeaux.map(compte);
    compris = compris.map(compte);
    var bouts = [];
    if (compris.length) bouts.push('Avec ' + liste(compris) + '.');
    if (cadeaux.length) bouts.push((items.filter(function (i) { return i.offert; }).length > 1 ? 'OFFERTS' : 'OFFERT') + ' : ' + liste(cadeaux) + '.');
    return bouts.join(' ');
  }

  function carteInfo(infos) {
    var m = carte({
      image: infos[0].image,
      titre: 'Vos articles forment ' + liste(infos.map(function (i) { return 'le ' + i.titre; })),
      prix: null,
      detail: mentionAjouts([].concat.apply([], infos.map(function (i) { return i.offerts || []; })))
    });
    var avantage = infos.reduce(function (t, i) {
      return t + (i.avantage != null ? i.avantage : i.economie);
    }, 0);
    if (avantage > 0) {
      m.el.querySelector('.ocaou-sugg__txt')
        .appendChild(bloc('ocaou-sugg__prix', 'vous gagnez ' + prix(avantage)));
    }
    m.el.classList.add('ocaou-sugg--info');
    var ok = bloc('ocaou-sugg__ok', 'J’ai compris', 'button');
    ok.type = 'button';
    ok.addEventListener('click', function () {
      infoCourante = null;
      document.querySelectorAll('[data-ocaou-sugg="panier"]').forEach(function (n) { n.remove(); });
    });
    m.actions.appendChild(ok);
    return m.el;
  }

  function carteProposition(trouve) {
    var c = trouve.coffret;
    var m = carte({
      image: c.image,
      titre: 'Passez au ' + c.titre,
      prix: trouve.combi.prix,
      barre: trouve.combi.prixBarre,
      detail: 'Votre article + ' + liste(trouve.enPlus.map(function (i) { return i.nom; })) + '.'
    });

    var non = bloc('ocaou-sugg__non', 'Compris', 'button');
    non.type = 'button';
    non.addEventListener('click', function () {
      refuses.push(c.id);
      try { sessionStorage.setItem('ocaou-sugg-refus', JSON.stringify(refuses)); } catch (e) {}
      m.el.remove();
    });

    var oui = bloc('ocaou-sugg__cta', 'Passer au coffret', 'button');
    oui.type = 'button';
    oui.addEventListener('click', function () {
      oui.disabled = true;
      oui.textContent = 'Un instant…';
      enCours = true;
      echange(trouve).then(function () { apres(trouve); }).catch(function () {
        enCours = false;
        oui.disabled = false;
        oui.textContent = 'Passer au coffret';
      });
    });

    m.actions.appendChild(non);
    m.actions.appendChild(oui);
    return m.el;
  }

  /* ------------------------------------------------------------- rendu */

  function hotesPanier() {
    var hotes = [];
    var recap = document.querySelector('.cart-order');
    if (recap && recap.parentElement) hotes.push({ parent: recap.parentElement, avant: recap, serre: false });
    document.querySelectorAll('[name="checkout"]').forEach(function (bouton) {
      if (recap && recap.contains(bouton)) return;
      var f = bouton.closest('form');
      if (f && f.parentElement) hotes.push({ parent: f.parentElement, avant: f, serre: true });
    });
    // Panier lateral : ses boutons menent a la page panier, pas au paiement.
    document.querySelectorAll('cart-drawer form.buy-buttons').forEach(function (f) {
      if (f.parentElement && !hotes.some(function (h) { return h.parent === f.parentElement; })) {
        hotes.push({ parent: f.parentElement, avant: f, serre: true });
      }
    });
    return hotes;
  }

  function pose(fabrique) {
    hotesPanier().forEach(function (h) {
      if (h.parent.querySelector('[data-ocaou-sugg="panier"]')) return;
      var c = fabrique();
      if (h.serre) c.classList.add('ocaou-sugg--serre');
      h.parent.insertBefore(c, h.avant);
    });
  }

  // Un cadeau achete seul alors qu'un coffret du panier le contient deja :
  // l'exemplaire paye part, le coffret apporte le sien.
  function cadeauxEnDouble(panier) {
    var retraits = [], infos = [];
    var memo = lisVus(panier);
    var formes = (memo && memo.formes) || {};
    var vus = {};
    panier.items.forEach(function (it) {
      if (table.coffrets.some(function (x) { return x.id === it.product_id; })) vus[it.key] = it.quantity;
    });
    // Premier passage sur ce panier : ce qui est deja la reste tel quel.
    var nouveaux = {};
    if (memo) {
      Object.keys(vus).forEach(function (k) {
        var ligne = panier.items.find(function (it) { return it.key === k; });
        var n = vus[k] - ((memo.vus || {})[k] || 0);
        var dejaFormes = Math.min(Math.max(n, 0), formes[ligne.variant_id] || 0);
        if (dejaFormes) formes[ligne.variant_id] -= dejaFormes;
        if (n - dejaFormes > 0) nouveaux[k] = n - dejaFormes;
      });
    }
    ecrisVus({ token: panier.token, vus: vus, formes: formes });

    var restant = {};
    panier.items.forEach(function (it) { restant[it.key] = it.quantity; });
    panier.items.forEach(function (it) {
      var c = table.coffrets.find(function (x) { return x.id === it.product_id; });
      if (!c || !nouveaux[it.key]) return;
      var combi = null;
      Object.keys(c.combinaisons).some(function (k) {
        if (c.combinaisons[k].variante !== it.variant_id) return false;
        combi = c.combinaisons[k];
        return true;
      });
      var cadeaux = c.inclus.filter(function (inc) { return inc.offert; });
      var repris = false;
      cadeaux.forEach(function (inc) {
        var besoin = nouveaux[it.key];
        panier.items.forEach(function (l) {
          if (!besoin || l.product_id !== inc.produit || !restant[l.key]) return;
          var n = Math.min(besoin, restant[l.key]);
          restant[l.key] -= n;
          besoin -= n;
          repris = true;
        });
      });
      if (repris) {
        var annonce = cadeaux.reduce(function (t, i) { return t + (i.prix || 0); }, 0) +
                      (combi ? Math.max(0, (combi.prixBarre || 0) - combi.prix) : 0);
        infos.push({
          titre: c.titre, avantage: annonce, image: c.image,
          offerts: cadeaux.map(function (i) { return { nom: i.nom, offert: true, prix: i.prix || 0 }; })
        });
      }
    });
    panier.items.forEach(function (it) {
      if (restant[it.key] !== it.quantity) retraits.push({ ligne: it, quantite: restant[it.key] });
    });
    return { retraits: retraits, infos: infos };
  }

  // Une seule lecture du panier a la fois : deux lectures paralleles feraient
  // chacune le meme regroupement, et le coffret arriverait en double.
  var enLecture = false, aRelire = false;

  function passe() {
    if (!table || enCours) return;
    if (!hotesPanier().length) return;
    if (enLecture) { aRelire = true; return; }
    enLecture = true;

    fetch(window.Shopify.routes.root + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (panier) {
        document.querySelectorAll('[data-ocaou-sugg="panier"]').forEach(function (n) { n.remove(); });

        // Cadeau « offert avec » un coffret qui n'est plus au panier : il part avec lui.
        var doubles = cadeauxEnDouble(panier);
        if (doubles.retraits.length) {
          enCours = true;
          var infosDoubles = infosEnAttente().concat(doubles.infos);
          infoCourante = null;
          try { sessionStorage.setItem('ocaou-sugg-info', JSON.stringify(infosDoubles)); } catch (e) {}
          var suiteDoubles = Promise.resolve();
          doubles.retraits.forEach(function (r) {
            suiteDoubles = suiteDoubles.then(function () {
              return fetch(window.Shopify.routes.root + 'cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: r.ligne.key, quantity: r.quantite })
              });
            });
          });
          suiteDoubles.then(function () {
            enCours = false;
            if (window.location.pathname.indexOf('/cart') !== -1) window.location.reload();
            else if (window.OCAOUCart && window.OCAOUCart.refresh) window.OCAOUCart.refresh();
          }, function () { enCours = false; });
          return;
        }

        var trouve = panier.items && panier.items.length >= 2 ? chercheCoffret(panier) : null;
        // Seul un regroupement automatique les reprend (il les absorbe dans le coffret).
        var orphelins = trouve && trouve.economie > 0 ? [] : (panier.items || []).filter(function (it) {
          return Object.keys(it.properties || {}).some(function (k) { return /cadeau offert/i.test(k); });
        });
        if (orphelins.length) {
          enCours = true;
          var suite = Promise.resolve();
          orphelins.forEach(function (l) {
            suite = suite.then(function () {
              return fetch(window.Shopify.routes.root + 'cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: l.key, quantity: 0 })
              });
            });
          });
          suite.then(function () {
            enCours = false;
            if (window.location.pathname.indexOf('/cart') !== -1) window.location.reload();
            else if (window.OCAOUCart && window.OCAOUCart.refresh) window.OCAOUCart.refresh();
          }, function () { enCours = false; });
          return;
        }

        // Moins cher : on regroupe tout seul, le client est informe apres coup.
        // Les regroupements s'enchainent jusqu'au meilleur panier possible.
        if (trouve && trouve.economie > 0) {
          enCours = true;
          echange(trouve).then(function () { apres(trouve); }).catch(function () {
            enCours = false;
            if (window.OCAOUCart && window.OCAOUCart.refresh) window.OCAOUCart.refresh();
          });
          return;
        }

        // Message qui suit un regroupement automatique. Il est garde en memoire :
        // le panier se redessine plusieurs fois et effacerait la carte.
        var infos = infosEnAttente();
        try { sessionStorage.removeItem('ocaou-sugg-info'); } catch (e) {}
        if (infos.length) {
          infoCourante = infos;
          pose(function () { return carteInfo(infoCourante); });
          return;
        }

        if (!trouve) return;

        // Plus cher parce que le coffret ajoute des articles : on ne l'impose pas.
        if (refuses.indexOf(trouve.coffret.id) !== -1) return;
        pose(function () { return carteProposition(trouve); });
      })
      .catch(function () {})
      .then(function () {
        enLecture = false;
        if (aRelire) { aRelire = false; setTimeout(passe, 0); }
      });
  }


  fetch(SOURCE)
    .then(function (r) { return r.json(); })
    .then(function (t) {
      table = t;
      passe();
      document.addEventListener('cart:change', passe);
      document.addEventListener('cart:refresh', passe);
      var minuteur = null;
      // On ne relit le panier que lorsqu'il se redessine, et jamais pour nos propres
      // cartes : sinon chaque carte posee relance la lecture, sans fin.
      var pagePanier = window.location.pathname.indexOf('/cart') !== -1;
      function nous(n) {
        return n.nodeType === 1 && (n.hasAttribute('data-ocaou-sugg') || n.closest('[data-ocaou-sugg]'));
      }
      new MutationObserver(function (records) {
        var utile = records.some(function (r) {
          var cible = r.target.nodeType === 1 ? r.target : r.target.parentElement;
          if (!cible || nous(cible)) return false;
          if (!pagePanier && !cible.closest('cart-drawer')) return false;
          var noeuds = [].slice.call(r.addedNodes).concat([].slice.call(r.removedNodes));
          return noeuds.some(function (n) { return !nous(n); });
        });
        if (!utile) return;
        clearTimeout(minuteur);
        minuteur = setTimeout(passe, 250);
      }).observe(document.body, { childList: true, subtree: true });
    })
    .catch(function () { /* le regroupement est un bonus : son absence ne casse rien */ });
})();
</script>
