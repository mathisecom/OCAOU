{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
O'CAOU — SUGGESTION DE COFFRET
----------------------------------------------------------------------------------------------------------------------

Propose le coffret correspondant, jamais ne l'impose.

* Sur une fiche produit : signale que l'article existe aussi dans un coffret.
* Dans le panier : si les articles reunis forment un coffret, propose l'echange en un clic.

La table de correspondance vit dans assets/ocaou-coffrets.json, regeneree par
_scripts/ocaou-coffrets.py cote ISOMORPH. Aucun identifiant n'est ecrit en dur ici.
{%- endcomment -%}

<style>
  .ocaou-sugg {
    display: flex; align-items: center; gap: 14px;
    margin: 16px 0; padding: 14px 16px;
    border: 1px solid rgba(0,0,0,.12); border-radius: 14px;
    background: #fff; text-decoration: none; color: inherit;
  }
  .ocaou-sugg__img { flex: 0 0 auto; width: 52px; height: 52px; border-radius: 10px; object-fit: cover; background: #f3efe9; }
  .ocaou-sugg__txt { flex: 1 1 auto; min-width: 0; line-height: 1.35; }
  .ocaou-sugg__titre { font-weight: 600; margin-right: 6px; }
  .ocaou-sugg__prix { color: {{ settings.color_accent | default: '#cd9438' }}; font-weight: 600; }
  .ocaou-sugg__barre { text-decoration: line-through; opacity: .55; margin-left: 4px; }
  .ocaou-sugg__detail { display: block; font-size: .875em; opacity: .7; margin-top: 2px; }
  .ocaou-sugg__actions { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; }
  .ocaou-sugg__cta {
    display: inline-block; padding: 7px 14px; border-radius: 999px; border: 0; cursor: pointer;
    background: {{ settings.color_accent | default: '#cd9438' }}; color: #fff;
    font: inherit; font-size: .875em; font-weight: 600; line-height: 1.4; white-space: nowrap;
  }
  .ocaou-sugg__cta[disabled] { opacity: .6; cursor: wait; }
  .ocaou-sugg__non { border: 0; background: none; cursor: pointer; font: inherit; font-size: .875em; opacity: .55; padding: 4px; }
  .ocaou-sugg__non:hover { opacity: .9; }
  /* Peu de place : l'image reste a gauche du texte, les boutons passent dessous.
     Empiler l'image au-dessus du titre gachait une ligne entiere. */
  .ocaou-sugg--serre {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 12px;
    row-gap: 10px;
    align-items: center;
  }
  .ocaou-sugg--serre .ocaou-sugg__img { grid-column: 1; grid-row: 1; width: 40px; height: 40px; }
  .ocaou-sugg--serre .ocaou-sugg__txt { grid-column: 2; grid-row: 1; }
  .ocaou-sugg--serre .ocaou-sugg__actions { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; }
  .ocaou-sugg--serre .ocaou-sugg__cta { flex: 0 0 auto; }

  @media screen and (max-width: 749px) {
    .ocaou-sugg {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 12px;
      row-gap: 10px;
      align-items: center;
    }
    .ocaou-sugg__img { grid-column: 1; grid-row: 1; width: 40px; height: 40px; }
    .ocaou-sugg__txt { grid-column: 2; grid-row: 1; }
    .ocaou-sugg__actions { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; }
  }
</style>

<script>
(function () {
  var SOURCE = {{ 'ocaou-coffrets.json' | asset_url | json }};
  var table = null;
  var refuses = [];
  try { refuses = JSON.parse(sessionStorage.getItem('ocaou-sugg-refus') || '[]'); } catch (e) {}

  function prix(centimes) {
    return (centimes / 100).toFixed(2).replace('.', ',') + ' €';
  }

  function liste(noms) {
    if (!noms.length) return '';
    if (noms.length === 1) return noms[0];
    return noms.slice(0, -1).join(', ') + ' et ' + noms[noms.length - 1];
  }

  // Tout texte venant de la table est insere par textContent, jamais par innerHTML.
  function bloc(classe, texte, balise) {
    var n = document.createElement(balise || 'span');
    n.className = classe;
    if (texte != null) n.textContent = texte;
    return n;
  }

  function carte(options) {
    var el = document.createElement(options.href ? 'a' : 'div');
    el.className = 'ocaou-sugg';
    el.setAttribute('data-ocaou-sugg', options.zone);
    if (options.href) el.href = options.href;

    if (options.image) {
      var img = document.createElement('img');
      img.className = 'ocaou-sugg__img';
      img.alt = '';
      img.loading = 'lazy';
      img.src = options.image + (options.image.indexOf('?') === -1 ? '?' : '&') + 'width=104';
      el.appendChild(img);
    }

    var txt = bloc('ocaou-sugg__txt', null, 'div');
    txt.appendChild(bloc('ocaou-sugg__titre', options.titre));
    txt.appendChild(bloc('ocaou-sugg__prix', prix(options.prix)));
    if (options.barre) txt.appendChild(bloc('ocaou-sugg__barre', prix(options.barre)));
    if (options.detail) txt.appendChild(bloc('ocaou-sugg__detail', options.detail));
    el.appendChild(txt);

    var actions = bloc('ocaou-sugg__actions', null, 'div');
    el.appendChild(actions);
    return { el: el, actions: actions };
  }

  /* ------------------------------------------------------------------ panier */

  // Une ligne de panier qui est elle-meme un coffret compte pour ses articles :
  // c'est ce qui permet de proposer le coffret de trois a partir d'un duo plus un article.
  // Le prix reste porte par la ligne reelle, jamais par un composant.
  function deplie(panier) {
    var entrees = [];
    panier.items.forEach(function (it) {
      var composants = null;
      table.coffrets.some(function (c) {
        var comp = c.parVariante && c.parVariante[it.variant_id];
        if (!comp) return false;
        composants = comp;
        return true;
      });
      if (composants) {
        composants.forEach(function (comp) {
          entrees.push({ produit: comp.produit, variante: comp.variante, ligne: it, issuDunCoffret: true });
        });
      } else {
        entrees.push({ produit: it.product_id, variante: it.variant_id, ligne: it, issuDunCoffret: false });
      }
    });
    return entrees;
  }

  function chercheCoffret(panier) {
    var deplies = deplie(panier);

    // La table est rangee du plus grand coffret au plus petit : le premier qui
    // correspond est celui qui reunit le plus d'articles.
    for (var i = 0; i < table.coffrets.length; i++) {
      var c = table.coffrets[i];
      if (panier.items.some(function (it) { return it.product_id === c.id; })) continue; // deja pris

      var pris = [];
      var variantes = [];
      var complet = c.articles.every(function (produitId) {
        var e = deplies.find(function (d) {
          return d.produit === produitId && pris.indexOf(d) === -1;
        });
        if (!e) return false;
        pris.push(e);
        variantes.push(e.variante);
        return true;
      });
      if (!complet) continue;

      var cle = variantes.slice().sort(function (a, b) { return a - b; }).join('-');
      var combi = c.combinaisons[cle];
      if (!combi || !combi.dispo) continue;

      // Les articles compris d'office dans le coffret sortent aussi du panier.
      // Un article venant d'un coffret deja au panier n'est repris que si ce coffret
      // est deja en train d'etre absorbe : on ne pioche pas dans un coffret intact.
      var lignes = [];
      pris.forEach(function (d) { if (lignes.indexOf(d.ligne) === -1) lignes.push(d.ligne); });
      deplies.forEach(function (d) {
        if (pris.indexOf(d) !== -1) return;
        if (!c.inclus.some(function (inc) { return inc.variante === d.variante; })) return;
        if (d.issuDunCoffret && lignes.indexOf(d.ligne) === -1) return;
        pris.push(d);
        if (lignes.indexOf(d.ligne) === -1) lignes.push(d.ligne);
      });

      // Un coffret deja au panier ne se defait que s'il est absorbe en entier.
      // Sans cette regle, on lui emprunterait un article et on compterait son prix.
      var entier = lignes.every(function (ligne) {
        var total = deplies.filter(function (d) { return d.ligne === ligne; });
        return total.every(function (d) { return pris.indexOf(d) !== -1; });
      });
      if (!entier) continue;

      // Un seul exemplaire de chaque article part dans le coffret : on compare au prix
      // unitaire, meme si la ligne du panier en contient plusieurs.
      var actuel = lignes.reduce(function (t, l) { return t + l.final_price; }, 0);

      // Ce que le coffret apporte en plus de ce qui est deja dans le panier.
      var dejaLa = pris.map(function (d) { return d.variante; });
      var enPlus = c.inclus.filter(function (inc) { return dejaLa.indexOf(inc.variante) === -1; })
                           .map(function (inc) { return inc.nom; });

      if (combi.prix >= actuel && !enPlus.length) continue; // ni moins cher, ni plus complet

      return {
        coffret: c, combi: combi, lignes: lignes, actuel: actuel,
        economie: actuel - combi.prix, enPlus: enPlus
      };
    }
    return null;
  }

  function echange(trouve) {
    var suite = Promise.resolve();
    trouve.lignes.forEach(function (l) {
      suite = suite.then(function () {
        return fetch(window.Shopify.routes.root + 'cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: l.key, quantity: Math.max(0, l.quantity - 1) })
        });
      });
    });
    return suite.then(function () {
      var lignes = [{ id: trouve.combi.variante, quantity: 1 }];
      if (window.OCAOUCart && window.OCAOUCart.add) return window.OCAOUCart.add(lignes);
      return fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: lignes })
      }).then(function () { window.location.reload(); });
    });
  }

  function cartePanier(trouve) {
    var c = trouve.coffret;
    var gagne = trouve.economie > 0;
    var m = carte({
      zone: 'panier',
      image: c.image,
      titre: gagne ? 'Vos articles forment le ' + c.titre : 'Passez au ' + c.titre,
      prix: trouve.combi.prix,
      barre: gagne ? trouve.actuel : trouve.combi.prixBarre,
      detail: gagne
        ? (trouve.enPlus.length ? 'Avec ' + liste(trouve.enPlus) + ' en plus.' : 'Vous économisez ' + prix(trouve.economie) + '.')
        : 'Votre article + ' + liste(trouve.enPlus) + ', pour ' + prix(-trouve.economie) + ' de plus.'
    });

    var non = bloc('ocaou-sugg__non', 'Non merci', 'button');
    non.type = 'button';
    non.addEventListener('click', function () {
      refuses.push(c.id);
      try { sessionStorage.setItem('ocaou-sugg-refus', JSON.stringify(refuses)); } catch (e) {}
      m.el.remove();
    });

    var oui = bloc('ocaou-sugg__cta', gagne ? 'Remplacer' : 'Passer au coffret', 'button');
    oui.type = 'button';
    oui.addEventListener('click', function () {
      oui.disabled = true;
      oui.textContent = 'Un instant…';
      echange(trouve).then(function () {
        // Dans le tiroir, le panier se rafraichit tout seul : recharger le fermerait.
        // Sur la page panier, il faut recharger pour que les lignes se mettent a jour.
        var surLaPagePanier = window.location.pathname.indexOf('/cart') !== -1;
        if (!surLaPagePanier && window.OCAOUCart && window.OCAOUCart.add) { passe(); return; }
        window.location.reload();
      }).catch(function () {
        oui.disabled = false;
        oui.textContent = gagne ? 'Remplacer' : 'Passer au coffret';
      });
    });

    m.actions.appendChild(non);
    m.actions.appendChild(oui);
    return m.el;
  }

  function hotesPanier() {
    var hotes = [];
    var recap = document.querySelector('.cart-order');
    if (recap && recap.parentElement) hotes.push({ parent: recap.parentElement, avant: recap, compact: false });
    document.querySelectorAll('[name="checkout"]').forEach(function (bouton) {
      if (recap && recap.contains(bouton)) return;
      var f = bouton.closest('form');
      if (f && f.parentElement) hotes.push({ parent: f.parentElement, avant: f, compact: true });
    });
    return hotes;
  }

  function poseDansPanier() {
    var hotes = hotesPanier();
    if (!hotes.length) return;
    fetch(window.Shopify.routes.root + 'cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (panier) {
        document.querySelectorAll('[data-ocaou-sugg="panier"]').forEach(function (n) { n.remove(); });
        if (!panier.items || panier.items.length < 2) return;
        var trouve = chercheCoffret(panier);
        if (!trouve || refuses.indexOf(trouve.coffret.id) !== -1) return;
        hotes.forEach(function (h) {
          if (h.parent.querySelector('[data-ocaou-sugg="panier"]')) return;
          var carte = cartePanier(trouve);
          if (h.compact) carte.classList.add('ocaou-sugg--serre');
          h.parent.insertBefore(carte, h.avant);
        });
      })
      .catch(function () {});
  }

  /* ----------------------------------------------------------- fiche produit */

  // La variante actuellement choisie sur la fiche produit.
  function varianteChoisie() {
    var url = new URLSearchParams(window.location.search).get('variant');
    if (url) return parseInt(url, 10);
    var noeud = document.querySelector('.product-info variant-picker script[data-variant]') ||
                document.querySelector('variant-picker script[data-variant]');
    if (!noeud) return null;
    try { return JSON.parse(noeud.textContent || '{}').id || null; } catch (e) { return null; }
  }

  // La combinaison la moins chere qui contient la couleur choisie par le client.
  function combiPourVariante(c, varianteId) {
    var retenue = null;
    Object.keys(c.combinaisons).forEach(function (cle) {
      var v = c.combinaisons[cle];
      if (!v.dispo) return;
      if (cle.split('-').indexOf(String(varianteId)) === -1) return;
      if (retenue === null || v.prix < retenue.prix) retenue = v;
    });
    return retenue;
  }

  // La combinaison disponible la moins chere d'un coffret.
  function prixMini(c) {
    return Object.keys(c.combinaisons).reduce(function (m, k) {
      var v = c.combinaisons[k];
      return (!v.dispo) ? m : (m === null || v.prix < m.prix) ? v : m;
    }, null);
  }

  function poseDansFiche() {
    var meta = window.ShopifyAnalytics && window.ShopifyAnalytics.meta;
    if (!meta || !meta.page || meta.page.pageType !== 'product') return;
    var produitId = meta.product && meta.product.id;
    if (!produitId) return;

    // Certaines fiches portent deja un bloc de packs maison. On n'y repete pas un
    // coffret deja cite, mais on continue de signaler ceux qui manquent.
    var blocMaison = document.querySelector('.duoP-card, .kitR-card, .duoP-btn, .kitR-btn');
    var texteMaison = '';
    if (blocMaison) {
      var racine = blocMaison.closest('[class*="duoP"], [class*="kitR"], .product-info__block-item') || blocMaison;
      texteMaison = (racine.textContent || '').replace(/\s+/g, ' ').toLowerCase();
    }

    // Le bloc maison nomme parfois la meme offre autrement : on compare aussi le prix.
    function dejaCite(c) {
      if (!texteMaison) return false;
      if (texteMaison.indexOf(c.titre.toLowerCase()) !== -1) return true;
      var moins = prixMini(c);
      return moins ? texteMaison.indexOf(prix(moins.prix).toLowerCase()) !== -1 : false;
    }

    var candidats = table.coffrets.filter(function (c) {
      if (c.id === produitId || c.articles.indexOf(produitId) === -1) return false;
      return !dejaCite(c);
    });
    if (!candidats.length) return;

    // Le pas le plus court d'abord : le coffret qui demande le moins d'articles en plus.
    candidats.sort(function (a, b) { return a.articles.length - b.articles.length; });

    var hote = document.querySelector('.product-info buy-buttons');
    if (!hote || !hote.parentElement) return;
    if (hote.parentElement.querySelector('[data-ocaou-sugg="fiche"]')) return;

    candidats.slice(0, 2).reverse().forEach(function (c) {
      var autres = c.nomsArticles.filter(function (_, i) { return c.articles[i] !== produitId; });
      var choisie = varianteChoisie();
      var mini = (choisie && combiPourVariante(c, choisie)) || prixMini(c);
      if (!mini) return;

      var m = carte({
        zone: 'fiche',
        href: c.url + '?variant=' + mini.variante,
        image: c.image,
        titre: 'Aussi dans le ' + c.titre,
        prix: mini.prix,
        barre: mini.prixBarre,
        detail: 'Avec ' + liste(autres.concat(c.inclus.map(function (i) { return i.nom; }))) + '.'
      });
      m.actions.appendChild(bloc('ocaou-sugg__cta', 'Voir le coffret'));
      hote.parentElement.insertBefore(m.el, hote.nextSibling);
    });
  }

  /* ------------------------------------------------------------------ amorce */

  function passe() {
    if (!table) return;
    poseDansFiche();
    poseDansPanier();
  }

  fetch(SOURCE)
    .then(function (r) { return r.json(); })
    .then(function (t) {
      table = t;
      passe();
      // Le panier lateral s'ouvre et se rafraichit sans rechargement de page.
      document.addEventListener('cart:change', passe);
      document.addEventListener('cart:refresh', passe);
      // Changer de couleur sur la fiche doit reporter ce choix sur les coffrets proposes.
      document.addEventListener('variant:change', function () {
        document.querySelectorAll('[data-ocaou-sugg="fiche"]').forEach(function (n) { n.remove(); });
        poseDansFiche();
      });
      var minuteur = null;
      new MutationObserver(function () {
        clearTimeout(minuteur);
        minuteur = setTimeout(poseDansPanier, 250);
      }).observe(document.body, { childList: true, subtree: true });
    })
    .catch(function () { /* la suggestion est un bonus : son absence ne casse rien */ });
})();
</script>
